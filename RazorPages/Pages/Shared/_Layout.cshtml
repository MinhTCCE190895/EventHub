@inject BLL.Services.IWeatherService WeatherService
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    // Gọi dịch vụ lấy thông tin thời tiết Campus mặc định cho sidebar (Cần Thơ)
    var campusWeather = await WeatherService.GetWeatherAsync("Can Tho");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniEvent Hub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RazorPages.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-container">
        <!-- Sleek Left Sidebar -->
        <aside class="app-sidebar">
            <a class="sidebar-brand" asp-page="/Index">
                <i class="bi bi-shield-check text-primary"></i> UniEvent Hub
            </a>
            
            <nav class="sidebar-nav">
                <a class="sidebar-link @(currentPage == "/Index" ? "active" : "")" asp-page="/Index">
                    <i class="bi bi-compass-fill"></i> Khám phá
                </a>
                <a class="sidebar-link @(currentPage?.StartsWith("/Organizers") == true ? "active" : "")" asp-page="/Organizers/Index">
                    <i class="bi bi-person-badge-fill"></i> Organizers
                </a>
                <a class="sidebar-link @(currentPage?.StartsWith("/Categories") == true ? "active" : "")" asp-page="/Categories/Index">
                    <i class="bi bi-tags-fill"></i> Categories
                </a>
                <a class="sidebar-link @(currentPage?.StartsWith("/Tags") == true ? "active" : "")" asp-page="/Tags/Index">
                    <i class="bi bi-hash"></i> Tags
                </a>
                <a class="sidebar-link @(currentPage?.StartsWith("/Venues") == true ? "active" : "")" asp-page="/Venues/Index">
                    <i class="bi bi-building"></i> Venues
                </a>
                @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Organizer")))
                {
                    <a class="sidebar-link" href="https://localhost:7170/feedback-analytics" target="_blank">
                        <i class="bi bi-bar-chart-line-fill"></i> Phân tích đánh giá
                    </a>
                }
                <a class="sidebar-link @(currentPage == "/Privacy" ? "active" : "")" asp-page="/Privacy">
                    <i class="bi bi-shield-lock-fill"></i> Riêng tư
                </a>
            </nav>

            @if (campusWeather != null)
            {
                <div class="sidebar-weather-card">
                    <div class="weather-header">
                        <span class="weather-location">
                            <i class="bi bi-geo-alt-fill text-danger"></i> @campusWeather.Location
                        </span>
                        <span class="text-muted text-uppercase" style="font-size: 0.6rem;">Thời tiết</span>
                    </div>
                    <div class="weather-body">
                        <span class="weather-temp">@campusWeather.Temperature.ToString("0")°C</span>
                        <i class="bi @campusWeather.WeatherIconClass weather-icon-lg"></i>
                    </div>
                    <div class="weather-desc">@campusWeather.Condition</div>
                    <div class="weather-details">
                        <span class="weather-detail-item" title="Tốc độ gió">
                            <i class="bi bi-wind"></i> @campusWeather.WindSpeed.ToString("0.0") km/h
                        </span>
                        <span class="weather-detail-item" title="Độ ẩm">
                            <i class="bi bi-droplet-half"></i> @campusWeather.Humidity%
                        </span>
                    </div>
                </div>
            }

            <div class="sidebar-footer">
                <div>&copy; 2026 - UniEvent Hub</div>
            </div>
        </aside>


        <!-- Main Content Wrapper -->
        <div class="app-content">
            <!-- Mobile Toggle Header (Visible only on smaller screens) -->
            <header class="d-lg-none bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                <a class="sidebar-brand mb-0 fs-5" asp-page="/Index">
                    <i class="bi bi-shield-check text-primary"></i> UniEvent Hub
                </a>
                <button class="btn btn-outline-primary btn-sm border-0" type="button" onclick="toggleSidebar()">
                    <i class="bi bi-list fs-4"></i>
                </button>
            </header>

            <main class="content-body">
                @RenderBody()
            </main>

            <footer class="content-footer d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <div>
                &copy; 2026 - <strong>UniEvent Hub Team</strong>.
            </div>
                <div class="d-flex gap-3">
                    <a asp-page="/Privacy" class="text-decoration-none text-muted">Chính sách bảo mật</a>
                    <span class="text-muted">|</span>
                    <span class="text-primary font-weight-bold">FE-03 / FE-08 / FE-11</span>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function toggleSidebar() {
            const sidebar = document.querySelector('.app-sidebar');
            sidebar.classList.toggle('show');
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>