@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniEvent Hub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RazorPages.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-container">
        <!-- Sleek Left Sidebar -->
        <aside class="app-sidebar">
            <a class="sidebar-brand" asp-page="/Index">
                <i class="bi bi-shield-check text-primary"></i> UniEvent Hub
            </a>
            
            <nav class="sidebar-nav">
                @{
                    var isAdminOrOrganizer = User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Organizer"));
                    var isStudent = User.Identity?.IsAuthenticated == true && User.IsInRole("Student");
                }

                <!-- Links visible to everyone -->
                <a class="sidebar-link @(currentPage == "/Index" ? "active" : "")" asp-page="/Index">
                    <i class="bi bi-compass-fill"></i> Khám phá sự kiện
                </a>

                @if (!isStudent)
                {
                    <a class="sidebar-link" href="http://localhost:5210/">
                        <i class="bi bi-activity"></i> Live Dashboard
                    </a>
                }

                @if (isAdminOrOrganizer)
                {
                    <!-- Admin & Organizer only links -->
                    <a class="sidebar-link @(currentPage?.StartsWith("/Events") == true && currentPage != "/Events/MyFeedbacks" ? "active" : "")" asp-page="/Events/Index">
                        <i class="bi bi-calendar-event-fill"></i> Quản lý sự kiện
                    </a>
                    <a class="sidebar-link @(currentPage?.StartsWith("/Categories") == true ? "active" : "")" asp-page="/Categories/Index">
                        <i class="bi bi-tags-fill"></i> Quản lý danh mục
                    </a>
                    <a class="sidebar-link @(currentPage?.StartsWith("/Tags") == true ? "active" : "")" asp-page="/Tags/Index">
                        <i class="bi bi-hash"></i> Quản lý Thẻ
                    </a>
                    <a class="sidebar-link @(currentPage?.StartsWith("/Venues") == true ? "active" : "")" asp-page="/Venues/Index">
                        <i class="bi bi-building"></i> Quản lý địa điểm
                    </a>
                    <a class="sidebar-link" href="http://localhost:5210/feedback-analytics">
                        <i class="bi bi-bar-chart-line-fill"></i> Phân tích đánh giá
                    </a>
                }

                @if (isStudent)
                {
                    <!-- Student-only tabs -->

                    <a class="sidebar-link @(currentPage == "/Events/MyFeedbacks" ? "active" : "")" asp-page="/Events/MyFeedbacks">
                        <i class="bi bi-chat-left-heart-fill"></i> Đánh giá của tôi
                    </a>
                    <a class="sidebar-link @(currentPage == "/Events/Organizers" || currentPage == "/Events/OrganizerDetails" ? "active" : "")" asp-page="/Events/Organizers">
                        <i class="bi bi-people-fill"></i> Ban tổ chức
                    </a>
                    <a class="sidebar-link @(currentPage == "/Events/Followed" ? "active" : "")" asp-page="/Events/Followed">
                        <i class="bi bi-heart-fill"></i> Đang theo dõi
                    </a>
                }

                <a class="sidebar-link @(currentPage == "/Privacy" ? "active" : "")" asp-page="/Privacy">
                    <i class="bi bi-shield-lock-fill"></i> Riêng tư
                </a>
            </nav>

            <!-- Đồng hồ thời gian thực toàn hệ thống (UTC+7 Việt Nam) -->
            <div class="my-3 p-2.5 rounded-3 bg-light d-flex align-items-center justify-content-between text-muted" style="font-size: 0.72rem; border: 1px solid rgba(0,0,0,0.05);">
                <span><i class="bi bi-clock me-1 text-primary"></i> Hệ thống (UTC+7):</span>
                <strong id="liveSidebarClock" class="text-dark fw-bold">--:--:--</strong>
            </div>


            <!-- User Auth status block inside Sidebar -->
            <div class="mt-auto pt-3 border-top border-light">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center gap-3 mb-3 p-2 rounded-3 bg-light">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 1.1rem;">
                            @((User.Identity.Name ?? "U").Substring(0, 1).ToUpper())
                        </div>
                        <div class="overflow-hidden" style="line-height: 1.2;">
                            <div class="fw-bold text-truncate" style="font-size: 0.9rem;" title="@User.Identity.Name">@User.Identity.Name</div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold mt-1" style="font-size: 0.7rem; padding: 2px 6px;">
                                @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
                            </span>
                        </div>
                    </div>
                    <a href="http://localhost:5259/Account/Logout" class="btn btn-outline-danger w-100 btn-sm rounded-3 py-2 fw-semibold">
                        <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                    </a>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        <a href="http://localhost:5259/Account/Login" class="btn btn-primary btn-sm rounded-3 py-2 fw-semibold text-white">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                        </a>
                        <a href="http://localhost:5259/Account/Register" class="btn btn-outline-primary btn-sm rounded-3 py-2 fw-semibold">
                            <i class="bi bi-person-plus me-1"></i> Đăng ký
                        </a>
                    </div>
                }
            </div>
        </aside>


        <!-- Main Content Wrapper -->
        <div class="app-content">
            <!-- Mobile Toggle Header (Visible only on smaller screens) -->
            <header class="d-lg-none bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                <a class="sidebar-brand mb-0 fs-5" asp-page="/Index">
                    <i class="bi bi-shield-check text-primary"></i> UniEvent Hub
                </a>
                <button class="btn btn-outline-primary btn-sm border-0" type="button" onclick="toggleSidebar()">
                    <i class="bi bi-list fs-4"></i>
                </button>
            </header>

            <main class="content-body">
                @RenderBody()
            </main>

            <footer class="content-footer d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <div>
                &copy; 2026 - <strong>UniEvent Hub Team</strong>.
            </div>
                <div class="d-flex gap-3">
                    <a asp-page="/Privacy" class="text-decoration-none text-muted">Chính sách bảo mật</a>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function toggleSidebar() {
            const sidebar = document.querySelector('.app-sidebar');
            sidebar.classList.toggle('show');
        }

        // Live Clock toàn hệ thống (múi giờ UTC+7 Việt Nam)
        function updateSidebarClock() {
            const clockEl = document.getElementById('liveSidebarClock');
            if (clockEl) {
                const now = new Date();
                const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
                const localNow = new Date(utc + (3600000 * 7));
                
                const timeString = localNow.toLocaleTimeString('vi-VN', { 
                    hour: '2-digit', 
                    minute: '2-digit', 
                    second: '2-digit', 
                    hour12: false 
                });
                clockEl.textContent = timeString;
            }
        }
        setInterval(updateSidebarClock, 1000);
        document.addEventListener('DOMContentLoaded', updateSidebarClock);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>