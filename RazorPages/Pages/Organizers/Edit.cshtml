@page "{id:guid}"
@model RazorPages.Pages.Organizers.EditModel
@{
    ViewData["Title"] = "Edit Organizer";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h4 class="card-title fw-bold mb-0">Edit Organizer</h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Organizer.Id" />
                        
                        <div class="mb-3">
                            <label asp-for="Organizer.FullName" class="form-label fw-medium"></label>
                            <input asp-for="Organizer.FullName" class="form-control" />
                            <span asp-validation-for="Organizer.FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Organizer.Email" class="form-label fw-medium"></label>
                            <input asp-for="Organizer.Email" type="email" class="form-control" />
                            <span asp-validation-for="Organizer.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Organizer.StudentCode" class="form-label fw-medium"></label>
                            <input asp-for="Organizer.StudentCode" class="form-control" />
                            <span asp-validation-for="Organizer.StudentCode" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Organizer.IsActive">
                            <label class="form-check-label fw-medium" asp-for="Organizer.IsActive">Account is Active</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">Update Organizer</button>
                            <a asp-page="Index" class="btn btn-light">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
