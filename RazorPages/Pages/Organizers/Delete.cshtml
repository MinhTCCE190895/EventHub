@page "{id:guid}"
@model RazorPages.Pages.Organizers.DeleteModel
@{
    ViewData["Title"] = "Delete Organizer";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="alert alert-danger shadow-sm border-danger" role="alert">
                <h4 class="alert-heading fw-bold">Confirm Deletion</h4>
                <p>Are you sure you want to delete this organizer? This action cannot be undone and may affect related events.</p>
                <hr>
                
                <dl class="row mb-4 bg-white p-3 rounded">
                    <dt class="col-sm-4 text-muted">Full Name</dt>
                    <dd class="col-sm-8 fw-medium">@Model.Organizer.FullName</dd>

                    <dt class="col-sm-4 text-muted">Email</dt>
                    <dd class="col-sm-8">@Model.Organizer.Email</dd>
                </dl>

                <form method="post">
                    <input type="hidden" asp-for="Organizer.Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger px-4">Delete Permanently</button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
