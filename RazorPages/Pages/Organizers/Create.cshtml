@page
@model RazorPages.Pages.Organizers.CreateModel
@{
    ViewData["Title"] = "Add Organizer";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h4 class="card-title fw-bold mb-0">Add New Organizer</h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Organizer.FullName" class="form-label fw-medium"></label>
                            <input asp-for="Organizer.FullName" class="form-control" placeholder="Enter full name" />
                            <span asp-validation-for="Organizer.FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                <label asp-for="Organizer.Email" class="form-label">Email <span class="text-danger">*</span></label>
                <input asp-for="Organizer.Email" class="form-control" placeholder="example@unieventhub.com" />
                <span asp-validation-for="Organizer.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Organizer.Password" class="form-label">Mật khẩu <span class="text-danger">*</span></label>
                <input asp-for="Organizer.Password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Organizer.Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Organizer.ConfirmPassword" class="form-label">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                <input asp-for="Organizer.ConfirmPassword" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Organizer.ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">

                        <div class="mb-4">
                            <label asp-for="Organizer.StudentCode" class="form-label fw-medium"></label>
                            <input asp-for="Organizer.StudentCode" class="form-control" placeholder="e.g. SE123456" />
                            <span asp-validation-for="Organizer.StudentCode" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">Save Organizer</button>
                            <a asp-page="Index" class="btn btn-light">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
