@page "{id:guid}"
@model RazorPages.Pages.Organizers.DetailsModel
@{
    ViewData["Title"] = "Organizer Details";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h4 class="card-title fw-bold mb-0">Organizer Details</h4>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Full Name</dt>
                        <dd class="col-sm-8 fw-medium">@Model.Organizer.FullName</dd>

                        <dt class="col-sm-4 text-muted">Email</dt>
                        <dd class="col-sm-8">@Model.Organizer.Email</dd>

                        <dt class="col-sm-4 text-muted">Student Code</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Organizer.StudentCode) ? "-" : Model.Organizer.StudentCode)</dd>

                        <dt class="col-sm-4 text-muted">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.Organizer.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger">Inactive</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Joined Date</dt>
                        <dd class="col-sm-8">@Model.Organizer.CreatedAt.ToString("MMMM dd, yyyy")</dd>
                    </dl>
                </div>
                <div class="card-footer bg-light border-top-0 py-3 d-flex gap-2">
                    <a asp-page="./Edit" asp-route-id="@Model.Organizer.Id" class="btn btn-primary px-4">Edit</a>
                    <a asp-page="./Index" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>
