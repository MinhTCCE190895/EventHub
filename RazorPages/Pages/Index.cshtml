@page
@model IndexModel
@{
    ViewData["Title"] = "Khám phá sự kiện - UniEvent Hub";
}

<div class="page-header-minimal">
    <span class="page-badge-minimal">Explore Events</span>
    <h1 class="display-6 fw-bold mb-2">Tìm kiếm sự kiện</h1>
    <p class="text-muted">Khám phá và đặt vé cho các sự kiện hấp dẫn nhất tại UniEvent Hub.</p>
</div>

@Html.AntiForgeryToken()

<form id="searchForm" method="get" class="search-card-minimal">
    <!-- ViewType hidden input -->
    <input type="hidden" asp-for="ViewType" id="viewTypeInput" />

    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label asp-for="Keyword" class="form-label-minimal">Từ khóa tìm kiếm</label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 border-slate-200" style="border-radius: var(--radius-md) 0 0 var(--radius-md);">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input asp-for="Keyword" id="keywordInput" autocomplete="off" class="form-control form-control-minimal border-start-0" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;" placeholder="Nhập tên hoặc mô tả sự kiện..." maxlength="200" />
            </div>
            <span asp-validation-for="Keyword" class="text-danger small"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="CategoryId" class="form-label-minimal">Danh mục</label>
            <select asp-for="CategoryId" onchange="submitInstant()" class="form-select form-select-minimal">
                <option value="">Tất cả danh mục</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label asp-for="TimeFilter" class="form-label-minimal">Thời gian</label>
            <select asp-for="TimeFilter" onchange="submitInstant()" class="form-select form-select-minimal">
                <option value="">Tất cả</option>
                <option value="Upcoming">Sắp diễn ra</option>
                <option value="Ongoing">Đang diễn ra</option>
                <option value="Past">Đã kết thúc</option>
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="SortBy" class="form-label-minimal">Sắp xếp theo</label>
            <select asp-for="SortBy" onchange="submitInstant()" class="form-select form-select-minimal">
                <option value="DateAsc">Ngày diễn ra (Tăng dần)</option>
                <option value="DateDesc">Ngày diễn ra (Giảm dần)</option>
                <option value="NameAsc">Tên sự kiện (A-Z)</option>
                <option value="NameDesc">Tên sự kiện (Z-A)</option>
                <option value="Popularity">Mức độ phổ biến (Đặt vé nhiều)</option>
            </select>
        </div>
    </div>

    <!-- Date Range Filter -->
    <div class="row g-3 align-items-end mt-1">
        <div class="col-md-6">
            <label asp-for="StartDate" class="form-label-minimal">Từ ngày</label>
            <input type="date" id="startDateInput" asp-for="StartDate" onchange="submitInstant()" class="form-control form-control-minimal" />
            <span asp-validation-for="StartDate" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="EndDate" class="form-label-minimal">Đến ngày</label>
            <input type="date" id="endDateInput" asp-for="EndDate" onchange="submitInstant()" class="form-control form-control-minimal" />
            <span asp-validation-for="EndDate" class="text-danger small" id="endDateValMsg"></span>
        </div>
    </div>

    @if (Model.Tags != null && Model.Tags.Count > 0)
    {
        <div class="mt-4 border-top pt-3">
            <label class="form-label-minimal d-block mb-3">Lọc nhanh theo thẻ (Tags)</label>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var tag in Model.Tags)
                {
                    <div class="tag-badge-minimal">
                        <input class="tag-checkbox-minimal" type="checkbox"
                                name="TagIds" value="@tag.Id"
                                id="tag_@tag.Id"
                                @(Model.TagIds != null && Model.TagIds.Contains(tag.Id) ? "checked" : "")
                                onchange="submitInstant()" />
                        <label class="tag-label-minimal" for="tag_@tag.Id">
                            <i class="bi bi-tag-fill me-1"></i> @tag.Name
                        </label>
                    </div>
                }
            </div>
        </div>
    }
</form>

<div class="d-flex justify-content-between align-items-center mb-4">
    @if (Model.Results != null && Model.Results.Count > 0)
    {
        <h5 class="fw-bold mb-0 text-slate-800">
            Kết quả tìm kiếm (@Model.TotalCount sự kiện)
        </h5>
        
        <div class="d-flex align-items-center gap-3">
            <span class="text-muted small">
                Trang <strong>@Model.PageNumber</strong> / @Model.TotalPages
            </span>
            <!-- Layout toggle buttons -->
            <div class="btn-group btn-group-sm rounded-3 overflow-hidden border">
                <button type="button" onclick="changeView('Grid')" class="btn btn-light border-0 px-3 @(Model.ViewType == "Grid" ? "active btn-primary-minimal text-white" : "")" title="Xem dạng lưới">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                </button>
                <button type="button" onclick="changeView('List')" class="btn btn-light border-0 px-3 @(Model.ViewType == "List" ? "active btn-primary-minimal text-white" : "")" title="Xem dạng danh sách">
                    <i class="bi bi-list-task"></i>
                </button>
            </div>
        </div>
    }
</div>

<!-- Results and pagination area -->
<div id="resultsWrapper">
    @if (Model.Results == null || Model.Results.Count == 0)
    {
        <div class="text-center py-5 rounded-4 bg-white border border-2 border-dashed my-4">
            <div class="display-1 text-muted mb-3"><i class="bi bi-calendar-x"></i></div>
            <h5 class="fw-bold text-slate-700">Không tìm thấy sự kiện nào</h5>
            <p class="text-muted mb-0">Thử thay đổi từ khóa hoặc bộ lọc của bạn xem sao.</p>
        </div>
    }
    else
    {
        @if (Model.ViewType == "List")
        {
            <!-- List View Style -->
            <div class="d-flex flex-column gap-3 mb-5">
                @foreach (var card in Model.Results)
                {
                    var now = DateTime.UtcNow.AddHours(7);
                    string statusText = "Đang diễn ra";
                    string statusClass = "status-ongoing";
                    if (card.StartTime > now)
                    {
                        statusText = "Sắp diễn ra";
                        statusClass = "status-upcoming";
                    }
                    else if (card.EndTime < now)
                    {
                        statusText = "Đã kết thúc";
                        statusClass = "status-past";
                    }

                    var remaining = card.MaxCapacity - card.BookedCount;
                    string seatsClass = card.MaxCapacity > 0 ? (remaining <= 0 ? "seats-urgency-soldout" : (remaining <= 10 ? "seats-urgency-low" : "")) : "";

                    <div class="card-minimal card-minimal-list p-3 @(card.EndTime < now ? "is-past" : "")">
                        <div class="d-flex flex-column flex-md-row align-items-center gap-4">
                            <div class="flex-shrink-0 position-relative" style="width: 180px; aspect-ratio: 16/10; overflow: hidden; border-radius: var(--radius-md);">
                                <!-- Floating status badge -->
                                <span class="card-badge-overlay @statusClass" style="top: 8px; left: 8px; font-size: 0.65rem; padding: 0.25rem 0.6rem;">@statusText</span>
                                
                                <img src="@(string.IsNullOrEmpty(card.BannerUrl) ? "https://images.unsplash.com/photo-1511578314322-379afb476865?q=80&w=800&auto=format&fit=crop" : card.BannerUrl)"
                                     class="w-100 h-100" style="object-fit: cover;" alt="@card.Title" />
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="fw-bold mb-2 card-minimal-title" style="display: block; font-size: 1.15rem; margin-bottom: 0.5rem; -webkit-line-clamp: 1;">@card.Title</h5>
                                <div class="d-flex flex-wrap gap-4 align-items-center mb-3">
                                    <span class="card-minimal-meta">
                                        <i class="bi bi-calendar3"></i>
                                        <span>@card.StartTime.ToString("dd/MM/yyyy HH:mm")</span>
                                    </span>
                                    <span class="card-minimal-meta">
                                        <i class="bi bi-geo-alt"></i>
                                        <span>@card.VenueName</span>
                                    </span>
                                    <span class="card-minimal-meta">
                                        <i class="bi bi-person"></i>
                                        <span>@card.OrganizerName</span>
                                    </span>
                                    <span class="card-minimal-meta @seatsClass">
                                        <i class="bi bi-people"></i>
                                        <span>@(card.MaxCapacity > 0 ? (remaining <= 0 ? "Hết chỗ" : "Còn vé") : "Chỗ ngồi tự do")</span>
                                    </span>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    @if (card.TagNames != null)
                                    {
                                        @foreach (var tag in card.TagNames)
                                        {
                                            <span class="badge-tag-premium">
                                                #@tag
                                            </span>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="flex-shrink-0 text-end d-flex align-items-center gap-2">
                                @if (User.IsInRole("Student"))
                                {
                                    var isBookmarkedList = Model.BookmarkedEventIds.Contains(card.Id);
                                    <button type="button"
                                            class="btn btn-sm btn-bookmark @(isBookmarkedList ? "bookmarked" : "")"
                                            onclick="toggleBookmark(this, '@card.Id')"
                                            title="@(isBookmarkedList ? "Bỏ lưu" : "Lưu sự kiện")">
                                        <i class="bi @(isBookmarkedList ? "bi-bookmark-fill" : "bi-bookmark")"></i>
                                    </button>
                                }
                                <a asp-page="/Events/Detail" asp-route-id="@card.Id" class="btn-outline-minimal">
                                    Chi tiết <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Grid View Style (Default) -->
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
                @foreach (var card in Model.Results)
                {
                    var now = DateTime.UtcNow.AddHours(7);
                    string statusText = "Đang diễn ra";
                    string statusClass = "status-ongoing";
                    if (card.StartTime > now)
                    {
                        statusText = "Sắp diễn ra";
                        statusClass = "status-upcoming";
                    }
                    else if (card.EndTime < now)
                    {
                        statusText = "Đã kết thúc";
                        statusClass = "status-past";
                    }

                    var remaining = card.MaxCapacity - card.BookedCount;
                    string seatsClass = card.MaxCapacity > 0 ? (remaining <= 0 ? "seats-urgency-soldout" : (remaining <= 10 ? "seats-urgency-low" : "")) : "";

                    <div class="col">
                        <div class="card-minimal @(card.EndTime < now ? "is-past" : "")">
                            <div class="card-minimal-img-wrapper">
                                <!-- Floating status and calendar badge -->
                                <span class="card-badge-overlay @statusClass">@statusText</span>
                                
                                <img src="@(string.IsNullOrEmpty(card.BannerUrl) ? "https://images.unsplash.com/photo-1511578314322-379afb476865?q=80&w=800&auto=format&fit=crop" : card.BannerUrl)"
                                     class="card-minimal-img" alt="@card.Title" />
                            </div>
                            <div class="card-minimal-body">
                                <h5 class="card-minimal-title" title="@card.Title">@card.Title</h5>
                                
                                <!-- Group 1 - Logistics -->
                                <div class="card-group-minimal mt-auto">
                                    <span class="card-minimal-meta">
                                        <i class="bi bi-calendar3"></i>
                                        <span>@card.StartTime.ToString("dd/MM/yyyy HH:mm")</span>
                                    </span>
                                    <span class="card-minimal-meta">
                                        <i class="bi bi-geo-alt"></i>
                                        <span class="text-truncate" style="max-width: 150px;">@card.VenueName</span>
                                    </span>
                                </div>
 
                                <!-- Group 2 - Organizer & Quota -->
                                <div class="card-group-minimal mt-2">
                                    <span class="card-minimal-meta">
                                        <i class="bi bi-person"></i>
                                        <span class="text-truncate" style="max-width: 150px;">@card.OrganizerName</span>
                                    </span>
                                    <span class="card-minimal-meta @seatsClass">
                                        <i class="bi bi-people"></i>
                                        <span>@(card.MaxCapacity > 0 ? (remaining <= 0 ? "Hết chỗ" : "Còn vé") : "Chỗ ngồi tự do")</span>
                                    </span>
                                </div>
 
                                <!-- Tag & CTA Row -->
                                <div class="card-action-row-minimal">
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (card.TagNames != null)
                                        {
                                            @foreach (var tag in card.TagNames)
                                            {
                                                <span class="badge-tag-premium">
                                                    #@tag
                                                </span>
                                            }
                                        }
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (User.IsInRole("Student"))
                                        {
                                            var isBookmarked = Model.BookmarkedEventIds.Contains(card.Id);
                                            <button type="button"
                                                    class="btn btn-sm btn-bookmark @(isBookmarked ? "bookmarked" : "")"
                                                    onclick="toggleBookmark(this, '@card.Id')"
                                                    title="@(isBookmarked ? "Bỏ lưu" : "Lưu sự kiện")">
                                                <i class="bi @(isBookmarked ? "bi-bookmark-fill" : "bi-bookmark")"></i>
                                            </button>
                                        }
                                        <a asp-page="/Events/Detail" asp-route-id="@card.Id" class="btn-outline-minimal">
                                            Xem chi tiết <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* Minimal Pagination *@
        @if (Model.TotalPages > 1)
        {
            var routeData = new Dictionary<string, string>
            {
                { "Keyword", Model.Keyword ?? "" },
                { "CategoryId", Model.CategoryId?.ToString() ?? "" },
                { "TimeFilter", Model.TimeFilter ?? "" },
                { "SortBy", Model.SortBy ?? "" },
                { "ViewType", Model.ViewType ?? "Grid" }
            };

            if (Model.TagIds != null)
            {
                for (int t = 0; t < Model.TagIds.Count; t++)
                {
                    routeData.Add($"TagIds[{t}]", Model.TagIds[t].ToString());
                }
            }

            <nav aria-label="Phân trang">
                <ul class="pagination pagination-minimal justify-content-center">
                    @if (Model.PageNumber > 1)
                    {
                        var prevRoute = new Dictionary<string, string>(routeData) { { "PageNumber", (Model.PageNumber - 1).ToString() } };
                        <li class="page-item">
                             <a class="page-link ajax-page-link"
                                asp-page="./Index"
                                asp-all-route-data="prevRoute">
                                 <i class="bi bi-chevron-left"></i> Trước
                             </a>
                        </li>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        var pageRoute = new Dictionary<string, string>(routeData) { { "PageNumber", i.ToString() } };
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link ajax-page-link"
                               asp-page="./Index"
                               asp-all-route-data="pageRoute">
                                @i
                            </a>
                        </li>
                    }

                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        var nextRoute = new Dictionary<string, string>(routeData) { { "PageNumber", (Model.PageNumber + 1).ToString() } };
                        <li class="page-item">
                            <a class="page-link ajax-page-link"
                               asp-page="./Index"
                               asp-all-route-data="nextRoute">
                                Sau <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>

@section Scripts {
    <script>
        let searchDebounceTimer; // Timer for debouncing input requests
        const form = document.getElementById('searchForm');

        // Trigger search on typing with a 300ms delay to prevent excessive queries
        $('#keywordInput').on('input', function() {
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(() => {
                performSearchAjax();
            }, 300);
        });

        // Switch layouts between Grid and List
        function changeView(viewType) {
            document.getElementById('viewTypeInput').value = viewType;
            performSearchAjax();
        }

        // Fetch search results asynchronously using fetch, async/await, try/catch
        async function performSearchAjax() {
            // Validate date range on client-side (F.E Custom Validation)
            const startDate = document.getElementById('startDateInput')?.value;
            const endDate = document.getElementById('endDateInput')?.value;
            const validationMsg = document.getElementById('endDateValMsg');
            if (validationMsg) validationMsg.textContent = ''; // Reset validation message

            if (startDate && endDate && new Date(startDate) > new Date(endDate)) {
                if (validationMsg) {
                    validationMsg.textContent = 'Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu.';
                }
                return; // Stop execution if dates are invalid
            }

            const formData = new FormData(form);
            const queryParams = new URLSearchParams(formData).toString();
            const newUrl = `${window.location.pathname}?${queryParams}`;
            
            // Push history state to update browser address bar
            window.history.pushState({ path: newUrl }, '', newUrl);

            try {
                // Perform async fetch request to get new HTML content
                const response = await fetch(newUrl);
                if (!response.ok) return;
                const htmlString = await response.text();

                // Parse response HTML to swap out results section only
                const parser = new DOMParser();
                const doc = parser.parseFromString(htmlString, 'text/html');

                // Swap results wrapper
                document.getElementById('resultsWrapper').innerHTML = doc.getElementById('resultsWrapper').innerHTML;

                // Update result count header
                const currentHeader = document.querySelector('.d-flex.justify-content-between.align-items-center.mb-4');
                const newHeader = doc.querySelector('.d-flex.justify-content-between.align-items-center.mb-4');
                if (currentHeader && newHeader) {
                    currentHeader.innerHTML = newHeader.innerHTML;
                }

                bindPaginationLinks(); // Re-attach pagination event listeners
            } catch (error) {
                console.error("Error performing search query:", error);
            }
        }

        // Intercept pagination clicks to execute via AJAX
        function bindPaginationLinks() {
            document.querySelectorAll('.ajax-page-link').forEach(link => {
                link.addEventListener('click', async function(e) {
                    e.preventDefault();
                    const targetUrl = this.getAttribute('href');
                    
                    window.history.pushState({ path: targetUrl }, '', targetUrl);
                    
                    try {
                        const response = await fetch(targetUrl);
                        if (!response.ok) return;
                        const htmlString = await response.text();

                        const parser = new DOMParser();
                        const doc = parser.parseFromString(htmlString, 'text/html');

                        document.getElementById('resultsWrapper').innerHTML = doc.getElementById('resultsWrapper').innerHTML;

                        const currentHeader = document.querySelector('.d-flex.justify-content-between.align-items-center.mb-4');
                        const newHeader = doc.querySelector('.d-flex.justify-content-between.align-items-center.mb-4');
                        if (currentHeader && newHeader) {
                            currentHeader.innerHTML = newHeader.innerHTML;
                        }

                        bindPaginationLinks();
                        document.getElementById('searchForm').scrollIntoView({ behavior: 'smooth' }); // Scroll back to filter panel
                    } catch (error) {
                        console.error("Error navigating page:", error);
                    }
                });
            });
        }

        // Initialize pagination event listeners on page load
        $(document).ready(function() {
            bindPaginationLinks();
        });

        // Toggle bookmark asynchronously using AJAX POST (fetch API)
        async function toggleBookmark(buttonEl, eventId) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (!token) return;

            buttonEl.disabled = true;
            try {
                const response = await fetch(`?handler=ToggleBookmark&eventId=${eventId}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });
                if (!response.ok) return;
                const result = await response.json();

                if (result) {
                    const iconEl = buttonEl.querySelector('i');
                    if (result.bookmarked) {
                        buttonEl.classList.add('bookmarked');
                        iconEl.className = 'bi bi-bookmark-fill';
                        buttonEl.title = 'Bỏ lưu';
                    } else {
                        buttonEl.classList.remove('bookmarked');
                        iconEl.className = 'bi bi-bookmark';
                        buttonEl.title = 'Lưu sự kiện';
                    }
                }
            } catch (error) {
                console.error("Error toggling bookmark status:", error);
            } finally {
                buttonEl.disabled = false;
            }
        }
    </script>
}
