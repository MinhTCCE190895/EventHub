@page
@model RazorPages.Pages.Events.CreateModel
@{
    ViewData["Title"] = "Thêm sự kiện mới";
}

<div class="container py-4" style="max-width: 800px;">
    <div class="d-flex align-items-center gap-2 mb-4">
        <a asp-page="./Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h2 class="fw-bold mb-0">Thêm sự kiện mới</h2>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Title" class="form-label fw-medium">Tiêu đề <span class="text-danger">*</span></label>
                    <input asp-for="Input.Title" class="form-control" placeholder="Nhập tiêu đề sự kiện" />
                    <span asp-validation-for="Input.Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Description" class="form-label fw-medium">Mô tả <span class="text-danger">*</span></label>
                    <textarea asp-for="Input.Description" class="form-control" rows="4" placeholder="Nhập mô tả sự kiện"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.BannerUrl" class="form-label fw-medium">URL ảnh bìa</label>
                    <input asp-for="Input.BannerUrl" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="Input.BannerUrl" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.StartTime" class="form-label fw-medium">Thời gian bắt đầu <span class="text-danger">*</span></label>
                        <input asp-for="Input.StartTime" type="datetime-local" class="form-control" />
                        <span asp-validation-for="Input.StartTime" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.EndTime" class="form-label fw-medium">Thời gian kết thúc <span class="text-danger">*</span></label>
                        <input asp-for="Input.EndTime" type="datetime-local" class="form-control" />
                        <span asp-validation-for="Input.EndTime" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Status" class="form-label fw-medium">Trạng thái <span class="text-danger">*</span></label>
                    <select asp-for="Input.Status" asp-items="Model.Statuses" class="form-select">
                        <option value="">-- Chọn trạng thái --</option>
                    </select>
                    <span asp-validation-for="Input.Status" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-medium">Danh mục</label>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var item in Model.Categories)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Input.CategoryIds" value="@item.Value" id="category_@item.Value" 
                                    @(Model.Input?.CategoryIds != null && Model.Input.CategoryIds.Contains(int.Parse(item.Value)) ? "checked" : "")>
                                <label class="form-check-label" for="category_@item.Value">
                                    @item.Text
                                </label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="Input.CategoryIds" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-medium">Thẻ</label>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var item in Model.Tags)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Input.TagIds" value="@item.Value" id="tag_@item.Value"
                                    @(Model.Input?.TagIds != null && Model.Input.TagIds.Contains(int.Parse(item.Value)) ? "checked" : "")>
                                <label class="form-check-label" for="tag_@item.Value">
                                    @item.Text
                                </label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="Input.TagIds" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.VenueId" class="form-label fw-medium">Địa điểm <span class="text-danger">*</span></label>
                    <select asp-for="Input.VenueId" asp-items="Model.Venues" class="form-select">
                        <option value="">-- Chọn địa điểm --</option>
                    </select>
                    <span asp-validation-for="Input.VenueId" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.OrganizerId" class="form-label fw-medium">Nhà tổ chức <span class="text-danger">*</span></label>
                    <select asp-for="Input.OrganizerId" asp-items="Model.Organizers" class="form-select">
                        <option value="">-- Chọn nhà tổ chức --</option>
                    </select>
                    <span asp-validation-for="Input.OrganizerId" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> Tạo sự kiện
                    </button>
                    <a asp-page="./Index" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
