<!-- Modal xác nhận ẩn bình luận dành cho Admin -->
<div class="modal fade" id="hideCommentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold text-slate-800"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i> Xác nhận ẩn</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-slate-600 small py-3">
                Bạn có chắc chắn muốn ẩn bình luận này không? Bình luận sau khi ẩn sẽ hiển thị thông báo <em>"Bình luận đã bị admin ẩn"</em>.
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-light fw-bold rounded-3" data-bs-dismiss="modal">Hủy</button>
                <form method="post" asp-page-handler="HideComment" asp-route-id="@Model.EventItem.Id">
                    <input type="hidden" id="hideCommentIdInput" name="commentId" value="" />
                    <button type="submit" class="btn btn-sm btn-danger fw-bold rounded-3">Ẩn bình luận</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận xóa vĩnh viễn bình luận dành cho Admin -->
<div class="modal fade" id="deleteCommentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold text-slate-800"><i class="bi bi-trash-fill text-danger me-2"></i> Xác nhận xóa</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-slate-600 small py-3">
                Bạn có chắc chắn muốn xóa vĩnh viễn bình luận này không? Các câu trả lời liên quan cũng sẽ bị xóa.
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-light fw-bold rounded-3" data-bs-dismiss="modal">Hủy</button>
                <form method="post" asp-page-handler="DeleteComment" asp-route-id="@Model.EventItem.Id">
                    <input type="hidden" id="deleteCommentIdInput" name="commentId" value="" />
                    <button type="submit" class="btn btn-sm btn-danger fw-bold rounded-3">Xóa vĩnh viễn</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    function toggleReplies(id, btn) {
        const el = document.getElementById(id);
        const lbl = btn.querySelector('.lbl-text');
        const count = lbl ? lbl.getAttribute('data-count') : '';
        if (!el) return;
        if (el.style.display === 'none' || !el.style.display) {
            el.style.display = 'block';
            if (lbl) lbl.textContent = '▲ Ẩn câu trả lời';
        } else {
            el.style.display = 'none';
            if (lbl) lbl.textContent = `Xem ${count} câu trả lời`;
        }
    }

    function setReplyTarget(commentId, authorName) {
        document.getElementById('parentCommentIdInput').value = commentId;
        document.getElementById('replyingText').textContent = 'Đang trả lời ' + authorName;
        const badge = document.getElementById('replyingBadge');
        if (badge) {
            badge.classList.remove('d-none');
            badge.classList.add('d-flex');
        }
        const input = document.getElementById('commentInput');
        if (input) {
            input.scrollIntoView({ behavior: 'smooth', block: 'center' });
            input.focus();
        }
    }

    function cancelReply() {
        document.getElementById('parentCommentIdInput').value = '';
        const badge = document.getElementById('replyingBadge');
        if (badge) {
            badge.classList.remove('d-flex');
            badge.classList.add('d-none');
        }
    }

    function confirmHideComment(commentId) {
        document.getElementById('hideCommentIdInput').value = commentId;
        var modalElement = document.getElementById('hideCommentModal');
        var modal = new bootstrap.Modal(modalElement);
        modal.show();
    }

    function confirmDeleteComment(commentId) {
        document.getElementById('deleteCommentIdInput').value = commentId;
        var modalElement = document.getElementById('deleteCommentModal');
        var modal = new bootstrap.Modal(modalElement);
        modal.show();
    }

    document.addEventListener("DOMContentLoaded", function () {
        const currentEventId = "@Model.EventItem.Id";
        const currentUserId = "@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")";

        // Khởi tạo SignalR WebSocket Client kết nối tới Hub /eventhub
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/eventhub")
            .withAutomaticReconnect()
            .build();

        // Lắng nghe bình luận mới từ bất kỳ client nào đẩy qua SignalR
        connection.on("ReceiveComment", function (eventId, commentId, authorName, content, timeStr, role, parentCommentId) {
            if (eventId.toLowerCase() === currentEventId.toLowerCase()) {
                const noCommentsPlaceholder = document.getElementById("noCommentsPlaceholder");
                if (noCommentsPlaceholder) {
                    noCommentsPlaceholder.remove();
                }

                const initials = authorName ? authorName.trim().substring(0, 2).toUpperCase() : "U";
                let roleBadgeStyle = "background-color: #e2e8f0; color: #000000; font-weight: 600;";
                let roleBadgeText = "Sinh Viên";
                if (role === "Admin") {
                    roleBadgeStyle = "background-color: #dc3545; color: #000000; font-weight: 600;";
                    roleBadgeText = "Admin";
                } else if (role === "Organizer") {
                    roleBadgeStyle = "background-color: #fd7e14; color: #000000; font-weight: 600;";
                    roleBadgeText = "Ban Tổ Chức";
                }

                const isAdminUser = "@(User.IsInRole("Admin") ? "true" : "false")" === "true";
                let adminMenuHtml = "";
                if (isAdminUser) {
                    adminMenuHtml = `
                        <div class="dropdown">
                            <button class="btn btn-sm btn-link text-slate-400 p-0 text-decoration-none ms-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Tùy chọn quản trị">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3" style="font-size: 0.82rem;">
                                <li>
                                    <button type="button" class="dropdown-item text-warning fw-semibold" onclick="confirmHideComment('${commentId}')">
                                        <i class="bi bi-eye-slash me-1"></i> Ẩn bình luận
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item text-danger fw-semibold" onclick="confirmDeleteComment('${commentId}')">
                                        <i class="bi bi-trash me-1"></i> Xóa vĩnh viễn
                                    </button>
                                </li>
                            </ul>
                        </div>
                    `;
                }

                if (parentCommentId) {
                    const repliesList = document.getElementById("replies-" + parentCommentId);
                    if (repliesList) {
                        repliesList.style.display = "block";
                        const replyDiv = document.createElement("div");
                        replyDiv.className = "comment-item p-2.5 mb-2 bg-slate-50 rounded-3 border border-light position-relative";
                        replyDiv.id = "comment-" + commentId;
                        replyDiv.innerHTML = `
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-circle rounded-circle bg-primary bg-opacity-75 text-white d-flex align-items-center justify-content-center fw-bold" style="width: 26px; height: 26px; font-size: 0.72rem;">
                                        ${initials}
                                    </div>
                                    <div>
                                        <strong class="text-slate-800 fs-7">${authorName}</strong>
                                        <span class="badge ms-1" style="font-size: 0.6rem; ${roleBadgeStyle}">${roleBadgeText}</span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <small class="text-muted" style="font-size: 0.7rem;">${timeStr}</small>
                                    ${adminMenuHtml}
                                </div>
                            </div>
                            <div class="comment-body fs-7 ps-4 ms-1" id="comment-body-${commentId}">
                                <span class="text-slate-700">${content}</span>
                            </div>
                            <div class="ps-4 ms-1 mt-1">
                                <button type="button" class="btn btn-link btn-xs text-decoration-none text-primary p-0 fw-semibold" onclick="setReplyTarget('${parentCommentId}', '${authorName}')">
                                    <i class="bi bi-reply-fill me-1"></i>Trả lời
                                </button>
                            </div>
                        `;
                        repliesList.appendChild(replyDiv);
                    }
                } else {
                    const commentsList = document.getElementById("commentsList");
                    if (commentsList) {
                        const tempDiv = document.createElement("div");
                        tempDiv.innerHTML = `
                            <div class="comment-item p-3 mb-3 bg-white rounded-3 border shadow-3xs position-relative" id="comment-${commentId}">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-7" style="width: 32px; height: 32px;">
                                            ${initials}
                                        </div>
                                        <div>
                                            <strong class="text-slate-800 fs-7">${authorName}</strong>
                                            <span class="badge ms-1" style="font-size: 0.65rem; ${roleBadgeStyle}">${roleBadgeText}</span>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <small class="text-muted fs-7">${timeStr}</small>
                                        ${adminMenuHtml}
                                    </div>
                                </div>
                                <div class="comment-body fs-7 ps-4 ms-2 mb-2" id="comment-body-${commentId}">
                                    <span class="text-slate-700">${content}</span>
                                </div>
                                <div class="ps-4 ms-2">
                                    <button type="button" class="btn btn-link btn-xs text-decoration-none text-primary p-0 fw-semibold" onclick="setReplyTarget('${commentId}', '${authorName}')">
                                        <i class="bi bi-reply-fill me-1"></i>Trả lời
                                    </button>
                                </div>
                                <div class="replies-list ms-2 ps-3 border-start border-2 border-slate-200 mt-2" id="replies-${commentId}" style="display: none;"></div>
                            </div>
                        `;
                        commentsList.appendChild(tempDiv.firstElementChild);
                        commentsList.scrollTop = commentsList.scrollHeight;
                    }
                }
            }
        });

        // Lắng nghe tín hiệu ẩn bình luận thời gian thực từ Admin
        connection.on("ReceiveCommentHidden", function (commentId) {
            const commentBody = document.getElementById("comment-body-" + commentId);
            if (commentBody) {
                commentBody.innerHTML = '<span class="text-muted fst-italic"><i class="bi bi-eye-slash me-1"></i> Bình luận đã bị admin ẩn</span>';
            }
        });

        // Lắng nghe tín hiệu xóa bình luận thời gian thực từ Admin
        connection.on("ReceiveCommentDeleted", function (commentId) {
            const el = document.getElementById("comment-" + commentId);
            if (el) {
                el.remove();
            }
        });

        connection.start().then(function () {
            console.log("SignalR Live Q&A connected successfully.");
        }).catch(function (err) {
            console.error("SignalR connection error: ", err);
        });

        // Đăng bình luận qua SignalR WebSocket không cần reload trang
        const commentForm = document.getElementById("commentForm");
        if (commentForm && currentUserId) {
            commentForm.addEventListener("submit", function (e) {
                if (connection.state === signalR.HubConnectionState.Connected) {
                    e.preventDefault();
                    const input = document.getElementById("commentInput");
                    const parentInput = document.getElementById("parentCommentIdInput");
                    const text = input ? input.value.trim() : "";
                    const parentId = parentInput && parentInput.value ? parentInput.value : null;
                    if (!text) return;

                    connection.invoke("SendComment", currentEventId, currentUserId, text, parentId)
                        .then(function () {
                            if (input) input.value = "";
                            cancelReply();
                        })
                        .catch(function (err) {
                            console.error("Error sending comment via SignalR: ", err);
                            commentForm.submit(); // Fallback form POST
                        });
                }
            });
        }
    });
</script>
