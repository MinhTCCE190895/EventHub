@page "{id:guid}"
@model RazorPages.Pages.Events.DetailModel
@{
    ViewData["Title"] = Model.EventItem.Title;
}

<div class="container py-4">
    <!-- Nút quay lại trang khám phá -->
    <div class="mb-4">
        <a asp-page="/Index" class="btn btn-link text-decoration-none p-0 text-slate-500 hover-translate-left">
            <i class="bi bi-arrow-left me-1"></i> Quay lại trang khám phá
        </a>
    </div>

    <!-- Alert thông báo trạng thái đặt vé -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- BỐ CỤC CHÍNH: SPLIT-SCREEN REPORT -->
    <div class="row g-4">
        <!-- Cột trái: Tấm giấy trắng tài liệu (Whitepaper Sheet) -->
        <div class="col-lg-8">
            <div class="whitepaper-sheet shadow-sm">
                <!-- Header của Whitepaper -->
                <div class="whitepaper-header">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-2">
                        <span class="card-badge-overlay @Model.StatusClass" style="position: static; font-size: 0.72rem; padding: 0.35rem 0.75rem;">@Model.StatusText</span>
                    </div>
                    
                    <h1 class="whitepaper-title">@Model.EventItem.Title</h1>
                    
                    <!-- Danh mục và Tags được thiết kế đồng bộ dạng text tối giản của báo cáo khoa học -->
                    <div class="whitepaper-subtitle-meta d-flex flex-wrap align-items-center gap-3 mt-2 text-slate-500 fs-7">
                        @if (Model.EventItem.EventCategories != null && Model.EventItem.EventCategories.Any())
                        {
                            <span>Danh mục: <strong class="text-slate-800">@string.Join(", ", Model.EventItem.EventCategories.Select(ec => ec.Category.Name))</strong></span>
                        }
                        @if (Model.EventItem.EventTags != null && Model.EventItem.EventTags.Any())
                        {
                            <span>Tags: <strong class="text-slate-800">@string.Join(" ", Model.EventItem.EventTags.Select(et => "#" + et.Tag.Name))</strong></span>
                        }
                    </div>
                </div>

                <!-- Banner ảnh minh họa được tinh giản, gọn gàng -->
                <div class="whitepaper-banner-wrapper mb-4">
                    <img src="@(string.IsNullOrEmpty(Model.EventItem.BannerUrl) ? "https://images.unsplash.com/photo-1511578314322-379afb476865?q=80&w=1200&auto=format&fit=crop" : Model.EventItem.BannerUrl)" 
                         class="w-100 h-100" style="object-fit: cover;" alt="@Model.EventItem.Title" />
                </div>

                <!-- Phần 1: Thông tin logistics chung -->
                <div class="whitepaper-section">
                    <h5 class="whitepaper-section-title">1. Thông tin tổng quan</h5>
                    <div class="row g-3 mt-1">
                        <div class="col-sm-6">
                            <div class="whitepaper-meta-box">
                                <small class="text-muted">Thời gian diễn ra</small>
                                <div class="fw-bold text-slate-800">@Model.EventItem.StartTime.AddHours(7).ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="whitepaper-meta-box">
                                <small class="text-muted">Thời gian kết thúc</small>
                                <div class="fw-bold text-slate-800">@Model.EventItem.EndTime.AddHours(7).ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="whitepaper-meta-box">
                                <small class="text-muted">Địa điểm tổ chức</small>
                                <div class="fw-bold text-slate-800">@Model.EventItem.Venue?.Name</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="whitepaper-meta-box">
                                <small class="text-muted">Ban tổ chức</small>
                                <div class="fw-bold text-slate-800">@Model.EventItem.Organizer?.FullName</div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="whitepaper-divider" />

                <!-- Phần 2: Nội dung mô tả chi tiết -->
                <div class="whitepaper-section">
                    <h5 class="whitepaper-section-title">2. Nội dung sự kiện</h5>
                    <div class="whitepaper-content-text mt-2">
                        @Model.EventItem.Description
                    </div>
                </div>

                <hr class="whitepaper-divider" />

                <!-- Phần 3: Địa điểm và Sơ đồ vị trí -->
                <div class="whitepaper-section">
                    <h5 class="whitepaper-section-title">3. Địa điểm chi tiết</h5>
                    <div class="mt-2 text-slate-700">
                        <div><strong>@Model.EventItem.Venue?.Name</strong></div>
                        <div class="text-muted small mt-1">@Model.EventItem.Venue?.Address</div>
                    </div>
                </div>

                <hr class="whitepaper-divider" />

                <!-- Phần 4: Hỏi đáp & Bình luận (Live Q&A Hub) -->
                <div class="whitepaper-section" id="qa-hub-section">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="whitepaper-section-title mb-0">
                            <i class="bi bi-chat-left-text-fill text-primary me-2"></i> 4. Hỏi đáp & Bình luận (Live Q&A Hub)
                        </h5>
                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1.5 rounded-pill fw-semibold">
                            @(Model.Comments?.Count() ?? 0) bình luận
                        </span>
                    </div>

                    <!-- Danh sách bình luận hiện có -->
                    <div class="comments-list-wrapper mb-4" id="commentsList" style="max-height: 400px; overflow-y: auto; padding-right: 5px;">
                        @if (Model.Comments == null || !Model.Comments.Any())
                        {
                            <div class="p-4 text-center bg-light rounded-3 text-muted" id="noCommentsPlaceholder">
                                <i class="bi bi-chat-dots display-6 text-slate-300 d-block mb-2"></i>
                                <span class="small">Chưa có bình luận nào cho sự kiện này. Hãy là người đầu tiên đặt câu hỏi!</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var c in Model.Comments)
                            {
                                var initials = string.IsNullOrWhiteSpace(c.UserFullName) ? "U" : 
                                    (c.UserFullName.Trim().Split(' ').Length > 1 ? 
                                        (c.UserFullName.Trim().Split(' ')[0][0].ToString() + c.UserFullName.Trim().Split(' ')[c.UserFullName.Trim().Split(' ').Length - 1][0].ToString()).ToUpper() : 
                                        c.UserFullName.Substring(0, Math.Min(2, c.UserFullName.Length)).ToUpper());

                                <div class="comment-item p-3 mb-3 bg-white rounded-3 border shadow-3xs position-relative" id="comment-@c.Id">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-circle rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-7" style="width: 32px; height: 32px;">
                                                @initials
                                            </div>
                                            <div>
                                                <strong class="text-slate-800 fs-7">@c.UserFullName</strong>
                                                <span class="badge ms-1" style="font-size: 0.65rem; @c.RoleBadgeStyle">@c.RoleBadgeText</span>
                                            </div>
                                        </div>
                                        
                                        <div class="d-flex align-items-center gap-2">
                                            <small class="text-muted fs-7">@c.CreatedAt.AddHours(7).ToString("HH:mm:ss dd/MM/yyyy")</small>
                                            
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <div class="dropdown">
                                                    <button class="btn btn-sm btn-link text-slate-400 p-0 text-decoration-none ms-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Tùy chọn quản trị">
                                                        <i class="bi bi-three-dots-vertical"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3" style="font-size: 0.82rem;">
                                                        @if (!c.IsHidden)
                                                        {
                                                            <li>
                                                                <button type="button" class="dropdown-item text-warning fw-semibold" onclick="confirmHideComment('@c.Id')">
                                                                    <i class="bi bi-eye-slash me-1"></i> Ẩn bình luận
                                                                </button>
                                                            </li>
                                                        }
                                                        <li>
                                                            <button type="button" class="dropdown-item text-danger fw-semibold" onclick="confirmDeleteComment('@c.Id')">
                                                                <i class="bi bi-trash me-1"></i> Xóa vĩnh viễn
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    
                                    <div class="comment-body fs-7 ps-4 ms-2 mb-2" id="comment-body-@c.Id">
                                        @if (c.IsHidden)
                                        {
                                            <span class="text-muted fst-italic">
                                                <i class="bi bi-eye-slash me-1"></i> Bình luận đã bị admin ẩn
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-700">@c.Content</span>
                                        }
                                    </div>

                                    <div class="ps-4 ms-2">
                                        @if (User.Identity?.IsAuthenticated == true)
                                        {
                                            <button type="button" class="btn btn-link btn-xs text-decoration-none text-primary p-0 fw-semibold" onclick="setReplyTarget('@c.Id', '@c.UserFullName')">
                                                <i class="bi bi-reply-fill me-1"></i>Trả lời
                                            </button>
                                        }
                                    </div>

                                    <!-- Dropdown câu trả lời (FB / TikTok style) -->
                                    @if (c.Replies != null && c.Replies.Any())
                                    {
                                        <div class="mt-2 ms-4">
                                            <button type="button" class="btn btn-link p-0 text-decoration-none text-slate-600 fs-7 fw-semibold d-inline-flex align-items-center gap-1" onclick="toggleReplies('replies-@c.Id', this)">
                                                <i class="bi bi-arrow-return-right"></i>
                                                <span class="lbl-text" data-count="@c.Replies.Count">Xem @c.Replies.Count câu trả lời</span>
                                            </button>

                                            <div class="replies-list ms-2 ps-3 border-start border-2 border-slate-200 mt-2" id="replies-@c.Id" style="display: none;">
                                                @foreach (var r in c.Replies)
                                                {
                                                    var rInitials = string.IsNullOrWhiteSpace(r.UserFullName) ? "U" : 
                                                        (r.UserFullName.Trim().Split(' ').Length > 1 ? 
                                                            (r.UserFullName.Trim().Split(' ')[0][0].ToString() + r.UserFullName.Trim().Split(' ')[r.UserFullName.Trim().Split(' ').Length - 1][0].ToString()).ToUpper() : 
                                                            r.UserFullName.Substring(0, Math.Min(2, r.UserFullName.Length)).ToUpper());

                                                    <div class="comment-item p-2.5 mb-2 bg-slate-50 rounded-3 border border-light position-relative" id="comment-@r.Id">
                                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="avatar-circle rounded-circle bg-primary bg-opacity-75 text-white d-flex align-items-center justify-content-center fw-bold" style="width: 26px; height: 26px; font-size: 0.72rem;">
                                                                    @rInitials
                                                                </div>
                                                                <div>
                                                                    <strong class="text-slate-800 fs-7">@r.UserFullName</strong>
                                                                    <span class="badge ms-1" style="font-size: 0.6rem; @r.RoleBadgeStyle">@r.RoleBadgeText</span>
                                                                </div>
                                                            </div>

                                                            <div class="d-flex align-items-center gap-2">
                                                                <small class="text-muted" style="font-size: 0.7rem;">@r.CreatedAt.AddHours(7).ToString("HH:mm:ss dd/MM")</small>

                                                                @if (User.IsInRole("Admin"))
                                                                {
                                                                    <div class="dropdown">
                                                                        <button class="btn btn-sm btn-link text-slate-400 p-0 text-decoration-none ms-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                                            <i class="bi bi-three-dots-vertical"></i>
                                                                        </button>
                                                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3" style="font-size: 0.8rem;">
                                                                            @if (!r.IsHidden)
                                                                            {
                                                                                <li>
                                                                                    <button type="button" class="dropdown-item text-warning fw-semibold" onclick="confirmHideComment('@r.Id')">
                                                                                        <i class="bi bi-eye-slash me-1"></i> Ẩn bình luận
                                                                                    </button>
                                                                                </li>
                                                                            }
                                                                            <li>
                                                                                <button type="button" class="dropdown-item text-danger fw-semibold" onclick="confirmDeleteComment('@r.Id')">
                                                                                    <i class="bi bi-trash me-1"></i> Xóa vĩnh viễn
                                                                                </button>
                                                                            </li>
                                                                        </ul>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>

                                                        <div class="comment-body fs-7 ps-4 ms-1" id="comment-body-@r.Id">
                                                            @if (r.IsHidden)
                                                            {
                                                                <span class="text-muted fst-italic">
                                                                    <i class="bi bi-eye-slash me-1"></i> Bình luận đã bị admin ẩn
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-slate-700">@r.Content</span>
                                                            }
                                                        </div>

                                                        <div class="ps-4 ms-1 mt-1">
                                                            @if (User.Identity?.IsAuthenticated == true)
                                                            {
                                                                <button type="button" class="btn btn-link btn-xs text-decoration-none text-primary p-0 fw-semibold" onclick="setReplyTarget('@c.Id', '@r.UserFullName')">
                                                                    <i class="bi bi-reply-fill me-1"></i>Trả lời
                                                                </button>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="replies-list ms-2 ps-3 border-start border-2 border-slate-200 mt-2" id="replies-@c.Id" style="display: none;"></div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <!-- Form đăng bình luận -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form method="post" asp-page-handler="Comment" asp-route-id="@Model.EventItem.Id" id="commentForm" class="mt-3">
                            <input type="hidden" asp-for="ParentCommentId" id="parentCommentIdInput" value="" />
                            
                            <div id="replyingBadge" class="alert alert-info py-1 px-3 mb-2 small fw-semibold justify-content-between align-items-center rounded-3 d-none">
                                <span><i class="bi bi-reply-fill me-1"></i> <span id="replyingText">Đang trả lời...</span></span>
                                <button type="button" class="btn-close btn-sm" onclick="cancelReply()"></button>
                            </div>

                            <div class="form-group mb-2">
                                <label class="form-label fw-semibold text-slate-700 fs-7">Viết bình luận mới:</label>
                                <textarea asp-for="CommentText" id="commentInput" class="form-control rounded-3" rows="3" placeholder="Nhập thắc mắc hoặc ý kiến của bạn về sự kiện..." required></textarea>
                            </div>
                            <div class="text-end">
                                <button type="submit" id="btnSubmitComment" class="btn btn-primary px-4 fw-bold rounded-3 btn-gradient-primary">
                                    <i class="bi bi-send-fill me-1"></i> Gửi bình luận
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center small mb-0 rounded-3 border-0">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Bạn cần <a href="http://localhost:5259/Account/Login?returnUrl=@(System.Net.WebUtility.UrlEncode(HttpContext.Request.Path))" class="fw-bold text-decoration-none">đăng nhập</a> để tham gia hỏi đáp và gửi bình luận.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cột phải: Bảng điều khiển lơ lửng (Glassmorphic Action Panel) -->
        <div class="col-lg-4">
            <div class="sticky-top" style="top: 2rem; z-index: 100;">
                <div class="glass-action-panel shadow-sm">
                    <!-- Section Đặt vé -->
                    <div class="text-center mb-4">
                        <i class="bi bi-ticket-perforated-fill text-primary" style="font-size: 2.2rem;"></i>
                        <h5 class="fw-bold text-slate-800 mt-2 mb-1">ĐĂNG KÝ THAM GIA</h5>
                        <p class="text-muted small mb-0">Hệ thống phân phối vé sự kiện tự động</p>
                    </div>

                    <!-- Chỉ số sức chứa -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-1.5">
                            <span class="text-slate-600 small">Tổng chỗ ngồi:</span>
                            <strong class="text-slate-800">@Model.MaxCapacity</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1.5">
                            <span class="text-slate-600 small">Đã đăng ký:</span>
                            <strong class="text-slate-800">@Model.BookedCount</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <span class="text-slate-700 fw-semibold">Tình trạng vé:</span>
                            @if (Model.IsSoldOut)
                            {
                                <span class="badge bg-danger px-2 py-1 rounded-3">Hết vé</span>
                            }
                            else
                            {
                                <span class="badge bg-success px-2 py-1 rounded-3">Còn @Model.RemainingSeats vé</span>
                            }
                        </div>
                    </div>

                    <!-- Progress bar lấp đầy chỗ -->
                    <div class="mb-4">
                        <small class="text-muted d-block mb-1.5">Tỷ lệ đăng ký hiện tại</small>
                        <div class="progress rounded-pill" style="height: 8px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated @Model.ProgressColor" 
                                 role="progressbar" style="width: @Model.FillRate%" aria-valuenow="@Model.FillRate" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="d-flex justify-content-between mt-1 fs-7 text-muted">
                            <span>0%</span>
                            <span>@Model.FillRate.ToString("0.0")%</span>
                            <span>100%</span>
                        </div>
                    </div>

                    <!-- Nút hành động chính -->
                    <div class="d-grid gap-2 mb-4">
                        @if (Model.HasBooked)
                        {
                            <button class="btn btn-success py-3 fw-bold rounded-3 shadow-sm" disabled style="opacity: 0.95;">
                                <i class="bi bi-check-circle-fill me-1"></i> Bạn đã đặt vé rồi
                            </button>
                            <div class="text-center p-3 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25 mt-1">
                                <small class="text-muted d-block uppercase fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.5px;">MÃ VÉ THAM GIA CỦA BẠN</small>
                                <span class="fw-bold text-success font-monospace" style="font-size: 1.15rem; letter-spacing: 1px;">
                                    <i class="bi bi-qr-code me-1"></i>@Model.UserBooking?.TicketCode
                                </span>
                            </div>
                        }
                        else if (Model.IsPastEvent)
                        {
                            <button class="btn btn-secondary py-3 fw-bold rounded-3" disabled>
                                <i class="bi bi-calendar-x-fill me-1"></i> Sự kiện đã kết thúc
                            </button>
                        }
                        else if (Model.IsSoldOut)
                        {
                            <button class="btn btn-secondary py-3 fw-bold rounded-3" disabled>
                                <i class="bi bi-x-circle-fill me-1"></i> Đã hết chỗ ngồi
                            </button>
                        }
                        else
                        {
                            <a href="http://localhost:5210/events/@Model.EventItem.Id/book" class="btn btn-primary py-3 fw-bold rounded-3 shadow-sm hover-scale btn-gradient-primary">
                                <i class="bi bi-cursor-fill me-1"></i> Đăng Ký Đặt Vé Ngay
                            </a>
                        }
                    </div>

                    <hr class="border-light my-4" />

                    <!-- Widget Dự báo Thời tiết -->
                    <div class="weather-section-glass">
                        <h6 class="fw-bold text-slate-800 mb-3"><i class="bi bi-cloud-sun me-1 text-primary"></i> Dự báo thời tiết</h6>
                        
                        @if (Model.IsForecastAvailable)
                        {
                            @if (Model.EventWeather != null)
                            {
                                <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-white border border-light shadow-2xs">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold" style="font-size: 0.65rem; padding: 2px 6px;">
                                                Dự báo ngày diễn ra
                                            </span>
                                        </div>
                                        <h3 class="fw-bold text-slate-800 mb-0" style="font-size: 1.6rem;">@Model.EventWeather.Temperature.ToString("0")°C</h3>
                                        <span class="text-slate-600 fw-medium small">@Model.EventWeather.Condition</span>
                                    </div>
                                    <div class="text-end">
                                        <i class="bi @Model.EventWeather.WeatherIconClass" style="font-size: 2.2rem;"></i>
                                    </div>
                                </div>
                                <div class="text-center mt-3">
                                    <small class="text-muted" style="font-size: 0.68rem;">Khu vực: @Model.EventWeather.Location</small>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 text-center bg-white border border-light rounded-3 text-muted">
                                    <i class="bi bi-cloud-slash display-6 d-block mb-1 text-slate-400"></i>
                                    <span class="small">Không thể tải dữ liệu thời tiết.</span>
                                </div>
                            }
                        }
                        else
                        {
                            <!-- Option A: Glassmorphism skeleton placeholder -->
                            <div class="p-3.5 rounded-3 text-center border border-dashed border-slate-200 bg-white-50">
                                <i class="bi bi-clock-history text-slate-400 d-block mb-2" style="font-size: 1.5rem;"></i>
                                <h6 class="fw-bold text-slate-700 mb-1" style="font-size: 0.85rem;">Chưa có dự báo thời tiết</h6>
                                <p class="text-muted mb-0 small" style="line-height: 1.3; font-size: 0.72rem;">
                                    Dự báo thời tiết sẽ khả dụng trước ngày diễn ra sự kiện 3 ngày.
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

