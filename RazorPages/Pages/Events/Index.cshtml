@page
@model RazorPages.Pages.Events.IndexModel
@{
    ViewData["Title"] = "Quản lý Sự kiện";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Quản lý Sự kiện</h2>
        <a asp-page="./Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Thêm sự kiện
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tiêu đề</th>
                            <th>Địa điểm</th>
                            <th>Nhà tổ chức</th>
                            <th>Thời gian bắt đầu</th>
                            <th>Trạng thái</th>
                            <th>Đã đăng ký</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Events)
                        {
                            <tr>
                                <td>
                                    <span class="fw-medium">@item.Title</span>
                                    @if (!string.IsNullOrEmpty(item.BannerUrl))
                                    {
                                        <br /><small class="text-muted">Có ảnh bìa</small>
                                    }
                                </td>
                                <td>@item.VenueName</td>
                                <td>@item.OrganizerName</td>
                                <td>@item.StartTime.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @{
                                        var badgeClass = item.Status switch
                                        {
                                            "Draft"     => "bg-secondary",
                                            "Published" => "bg-success",
                                            "Cancelled" => "bg-danger",
                                            _           => "bg-light text-dark"
                                        };

                                        var statusText = item.Status switch
                                        {
                                            "Draft"     => "Bản nháp",
                                            "Published" => "Đã xuất bản",
                                            "Cancelled" => "Đã hủy",
                                            _           => item.Status
                                        };
                                    }
                                    <span class="badge @badgeClass">@statusText</span>
                                </td>
                                <td>
                                    <span class="badge bg-info bg-opacity-10 text-info px-2 py-1">
                                        @item.RegisteredCount / @item.VenueMaxCapacity
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form method="post" asp-page-handler="ChangeStatus" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                @if (item.Status == "Draft" || item.Status == "Cancelled")
                                                {
                                                    <button type="submit" name="status" value="Published" class="btn btn-outline-success" title="Duyệt sự kiện">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                }
                                                @if (item.Status == "Draft" || item.Status == "Published")
                                                {
                                                    <button type="submit" name="status" value="Cancelled" class="btn btn-outline-warning" title="Hủy sự kiện">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                }
                                            </form>
                                        }
                                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Events.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-calendar-x fs-1 d-block mb-3"></i>
                                    Chưa có sự kiện nào. <a asp-page="./Create">Thêm sự kiện đầu tiên</a>.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
