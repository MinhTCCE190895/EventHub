@page "{id:guid}"
@model RazorPages.Pages.Events.OrganizerDetailsModel
@{
    ViewData["Title"] = $"{Model.Organizer.FullName} - UniEvent Hub";
}

<div class="mb-4">
    <a asp-page="./Organizers" class="btn btn-link text-decoration-none p-0 text-muted">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
</div>

<div class="org-profile-header p-4 mb-5 rounded-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4 bg-white border border-light shadow-sm">
    <div class="d-flex align-items-center gap-4">
        <div class="org-large-avatar d-flex align-items-center justify-content-center fw-bold text-white text-uppercase">
            @Model.Organizer.FullName.Substring(0, 1)
        </div>
        <div>
            <h2 class="fw-bold mb-1">@Model.Organizer.FullName</h2>
            <p class="text-muted mb-2"><i class="bi bi-envelope me-1"></i> @Model.Organizer.Email</p>
            <div class="d-flex align-items-center gap-2 small">
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 fw-semibold">
                    <i class="bi-heart-fill me-1"></i> @Model.FollowerCount người theo dõi
                </span>
            </div>
        </div>
    </div>
    
    <div>
        @if (Model.IsFollowed)
        {
            <form method="post" asp-page-handler="Unfollow" asp-route-id="@Model.Organizer.Id">
                <button type="submit" class="btn btn-outline-danger px-4 py-2.5 fw-semibold rounded-3">
                    <i class="bi bi-heartbreak me-1"></i> Hủy theo dõi
                </button>
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="Follow" asp-route-id="@Model.Organizer.Id">
                <button type="submit" class="btn btn-primary px-4 py-2.5 fw-semibold rounded-3 text-white">
                    <i class="bi bi-heart me-1"></i> Theo dõi
                </button>
            </form>
        }
    </div>
</div>

<h4 class="fw-bold mb-4 text-slate-800">Sự kiện đã tạo (@Model.Events.Count())</h4>

@if (!Model.Events.Any())
{
    <div class="text-center py-5 rounded-4 bg-white border border-2 border-dashed my-4">
        <div class="display-1 text-muted mb-3"><i class="bi bi-calendar-x"></i></div>
        <h5 class="fw-bold text-slate-700">Chưa có sự kiện nào</h5>
        <p class="text-muted mb-0">Ban tổ chức này chưa công bố sự kiện nào.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
        @foreach (var card in Model.Events)
        {
            var now = DateTime.UtcNow.AddHours(7);
            string statusText = "Đang diễn ra";
            string statusClass = "status-ongoing";
            if (card.StartTime > now)
            {
                statusText = "Sắp diễn ra";
                statusClass = "status-upcoming";
            }
            else if (card.EndTime < now)
            {
                statusText = "Đã kết thúc";
                statusClass = "status-past";
            }

            var remaining = card.MaxCapacity - card.BookedCount;
            string seatsClass = card.MaxCapacity > 0 ? (remaining <= 0 ? "seats-urgency-soldout" : (remaining <= 10 ? "seats-urgency-low" : "")) : "";

            <div class="col">
                <div class="card-minimal @(card.EndTime < now ? "is-past" : "")">
                    <div class="card-minimal-img-wrapper">
                        <span class="card-badge-overlay @statusClass">@statusText</span>
                        
                        <img src="@(string.IsNullOrEmpty(card.BannerUrl) ? "https://images.unsplash.com/photo-1511578314322-379afb476865?q=80&w=800&auto=format&fit=crop" : card.BannerUrl)"
                             class="card-minimal-img" alt="@card.Title" />
                    </div>
                    <div class="card-minimal-body">
                        <h5 class="card-minimal-title" title="@card.Title">@card.Title</h5>
                        
                        <div class="card-group-minimal mt-auto">
                            <span class="card-minimal-meta">
                                <i class="bi bi-calendar3"></i>
                                <span>@card.StartTime.ToString("dd/MM/yyyy HH:mm")</span>
                            </span>
                            <span class="card-minimal-meta">
                                <i class="bi bi-geo-alt"></i>
                                <span class="text-truncate" style="max-width: 150px;">@card.VenueName</span>
                            </span>
                        </div>

                        <div class="card-group-minimal mt-2">
                            <span class="card-minimal-meta">
                                <i class="bi bi-person"></i>
                                <span class="text-truncate" style="max-width: 150px;">@card.OrganizerName</span>
                            </span>
                            <span class="card-minimal-meta @seatsClass">
                                <i class="bi bi-people"></i>
                                <span>@(card.MaxCapacity > 0 ? (remaining <= 0 ? "Hết chỗ" : "Còn vé") : "Chỗ ngồi tự do")</span>
                            </span>
                        </div>

                        <div class="card-action-row-minimal">
                            <div class="d-flex flex-wrap gap-1">
                                @if (card.TagNames != null)
                                {
                                    @foreach (var tag in card.TagNames)
                                    {
                                        <span class="badge-tag-premium">
                                            #@tag
                                        </span>
                                    }
                                }
                            </div>
                            <a asp-page="/Events/Detail" asp-route-id="@card.Id" class="btn-outline-minimal">
                                Chi tiết <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
