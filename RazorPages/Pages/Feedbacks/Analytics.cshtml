@page
@model RazorPages.Pages.Feedbacks.AnalyticsModel
@{
    ViewData["Title"] = "Phân tích đánh giá";
}

<div class="container mt-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="/Index">Explore</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Feedback Analytics</li>
                </ol>
            </nav>
            <h1 class="h3 mb-1 text-primary fw-bold">Phân tích đánh giá</h1>
            <p class="text-muted mb-0">🎬 @Model.Event.Title</p>
        </div>
        <a asp-page="./Submit" asp-route-eventId="@Model.EventId" class="btn btn-outline-primary rounded-pill">
            <i class="bi bi-pencil-square"></i> Gửi đánh giá mới
        </a>
    </div>

    @if (Model.AverageScores.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-chat-left-heart text-muted display-1"></i>
                <h3 class="h5 mt-3 text-secondary fw-bold">Chưa có đánh giá nào</h3>
                <p class="text-muted">Hãy là người đầu tiên gửi đánh giá cho sự kiện này!</p>
                <a asp-page="./Submit" asp-route-eventId="@Model.EventId" class="btn btn-primary rounded-pill px-4 mt-2">Đánh giá ngay</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Left Column: Metrics -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h5 class="card-title fw-bold mb-4 text-dark">Điểm số theo tiêu chí (PLINQ)</h5>

                        @foreach (var score in Model.AverageScores)
                        {
                            var percentage = (score.Value / 5.0) * 100;
                            string progressColorClass = "bg-primary";
                            if (score.Value < 3.0) progressColorClass = "bg-danger";
                            else if (score.Value < 4.0) progressColorClass = "bg-warning";
                            else progressColorClass = "bg-success";

                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold text-secondary">@score.Key</span>
                                    <span class="badge bg-light text-dark fw-bold border">@score.Value / 5.0 ⭐</span>
                                </div>
                                <div class="progress rounded-pill" style="height: 12px; background-color: #eef2f7;">
                                    <div class="progress-bar @progressColorClass rounded-pill" role="progressbar" style="width: @percentage%" aria-valuenow="@score.Value" aria-valuemin="0" aria-valuemax="5"></div>
                                </div>
                            </div>
                        }

                        <div class="mt-4 p-3 bg-light rounded-3 text-muted small border-start border-primary border-3">
                            <i class="bi bi-info-circle me-1 text-primary"></i> 
                            Các chỉ số trên được tổng hợp và tính toán song song sử dụng công nghệ <strong>PLINQ (.AsParallel())</strong> trên nhiều nhân CPU để tối ưu hóa hiệu năng hệ thống khi xử lý dữ liệu lớn.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Comments -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h5 class="card-title fw-bold mb-3 text-dark">Ý kiến góp ý gần đây</h5>
                        
                        <div class="comments-list" style="max-height: 400px; overflow-y: auto; padding-right: 5px;">
                            @if (Model.RecentComments.Count == 0)
                            {
                                <p class="text-muted fst-italic">Không có nhận xét hoặc góp ý bằng chữ nào.</p>
                            }
                            else
                            {
                                @foreach (var comment in Model.RecentComments)
                                {
                                    <div class="p-3 bg-light rounded-3 mb-3 border-start border-primary border-4 shadow-sm">
                                        <p class="mb-0 text-dark" style="font-size: 14px; line-height: 1.6;">"@comment"</p>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
