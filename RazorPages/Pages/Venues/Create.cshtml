@page
@model RazorPages.Pages.Venues.CreateModel
@{
    ViewData["Title"] = "Thêm địa điểm mới";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-page="Index" class="text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h3 class="fw-bold mb-0">Thêm địa điểm mới</h3>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="VenueCreateDTO.Name" class="form-label fw-medium"></label>
                            <input asp-for="VenueCreateDTO.Name" class="form-control" placeholder="Nhập tên địa điểm" />
                            <span asp-validation-for="VenueCreateDTO.Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="VenueCreateDTO.MaxCapacity" class="form-label fw-medium"></label>
                            <input asp-for="VenueCreateDTO.MaxCapacity" class="form-control" type="number" min="1" placeholder="Nhập sức chứa tối đa" />
                            <span asp-validation-for="VenueCreateDTO.MaxCapacity" class="text-danger small"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label asp-for="VenueCreateDTO.Address" class="form-label fw-medium"></label>
                                <input asp-for="VenueCreateDTO.Address" class="form-control" placeholder="Nhập địa chỉ cụ thể (VD: Tòa nhà Alpha, Tầng 3)" />
                                <span asp-validation-for="VenueCreateDTO.Address" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="SelectedCampus" class="form-label fw-medium">Cơ sở</label>
                                <select asp-for="SelectedCampus" asp-items="Model.Campuses" class="form-select">
                                    <option value="">-- Chọn cơ sở --</option>
                                </select>
                                <span asp-validation-for="SelectedCampus" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="VenueCreateDTO.Description" class="form-label fw-medium"></label>
                            <textarea asp-for="VenueCreateDTO.Description" class="form-control" rows="4" placeholder="Nhập mô tả địa điểm"></textarea>
                            <span asp-validation-for="VenueCreateDTO.Description" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-page="Index" class="btn btn-light">Hủy</a>
                            <button type="submit" class="btn btn-primary px-4">Tạo mới</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
