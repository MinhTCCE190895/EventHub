@page
@model RazorPages.Pages.Feedback.MyFeedbacksModel
@{
    ViewData["Title"] = "Đánh giá của tôi - UniEvent Hub";
}

<div class="page-header-minimal">
    <span class="page-badge-minimal">Pending Feedbacks</span>
    <h1 class="display-6 fw-bold mb-2">Đánh giá sự kiện</h1>
    <p class="text-muted">Danh sách các sự kiện bạn đã tham gia và chưa thực hiện gửi đánh giá phản hồi.</p>
</div>

<div class="container-fluid px-0 mt-4">
    @if (Model.PendingEvents == null || !Model.PendingEvents.Any())
    {
        <div class="text-center py-5 rounded-4 bg-white border border-2 border-dashed my-4">
            <div class="display-1 text-muted mb-3"><i class="bi bi-patch-check-fill text-success"></i></div>
            <h5 class="fw-bold text-slate-700">Tuyệt vời! Bạn không có đánh giá nào chưa gửi</h5>
            <p class="text-muted mb-0">Bạn đã hoàn thành đánh giá cho tất cả các sự kiện mình tham gia.</p>
            <a asp-page="/Index" class="btn btn-primary-minimal mt-3 rounded-pill px-4">Khám phá sự kiện mới</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ev in Model.PendingEvents)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card-minimal border-0 shadow-sm bg-glass position-relative overflow-hidden h-100 d-flex flex-column justify-content-between p-4">
                        <div>
                            <!-- Header with status / icon -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-warning bg-opacity-10 text-warning px-2.5 py-1 rounded-pill small fw-semibold">
                                    <i class="bi bi-clock-history me-1"></i> Đang chờ đánh giá
                                </span>
                            </div>

                            <!-- Event Details -->
                            <h4 class="fw-bold mb-2 text-slate-800 text-truncate-2" title="@ev.EventTitle" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 3rem; line-height: 1.5;">
                                @ev.EventTitle
                            </h4>
                            
                            <div class="text-muted small mb-2 mt-3">
                                <i class="bi bi-calendar3 me-2"></i> <strong>Thời gian:</strong> @ev.StartTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </div>
                            <div class="text-muted small mb-4">
                                <i class="bi bi-geo-alt me-2"></i> <strong>Địa điểm:</strong> @ev.VenueName
                            </div>
                        </div>

                        <!-- Action Button -->
                        <div class="mt-auto">
                            <a asp-page="/Feedback/Feedback" asp-route-eventId="@ev.EventId" class="btn btn-primary w-100 py-2.5 fw-bold rounded-3 shadow-sm text-decoration-none text-center d-block">
                                <i class="bi bi-chat-left-text me-2"></i> Viết Đánh Giá
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <style>
        .bg-glass {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .bg-glass:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-soft);
        }
    </style>
}
