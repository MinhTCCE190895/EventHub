@page
@model RazorPages.Pages.Categories.DetailsModel
@{
    ViewData["Title"] = "Category Details";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-page="Index" class="text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h3 class="fw-bold mb-0">Category Details</h3>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">ID</dt>
                        <dd class="col-sm-9">@Model.CategoryDTO.Id</dd>

                        <dt class="col-sm-3 text-muted">Name</dt>
                        <dd class="col-sm-9 fw-medium">@Model.CategoryDTO.Name</dd>

                        <dt class="col-sm-3 text-muted">Description</dt>
                        <dd class="col-sm-9">
                            @if (string.IsNullOrEmpty(Model.CategoryDTO.Description))
                            {
                                <span class="text-muted fst-italic">No description provided</span>
                            }
                            else
                            {
                                @Model.CategoryDTO.Description
                            }
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light border-top-0 py-3">
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-page="./Edit" asp-route-id="@Model.CategoryDTO.Id" class="btn btn-primary px-4">
                            <i class="bi bi-pencil me-1"></i> Edit
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
