@page
@model RazerPages.Pages.Explore.IndexModel
@{
    ViewData["Title"] = "Khám phá sự kiện";
}

<h2 class="mb-4">Khám phá sự kiện</h2>

<form method="get" class="mb-4">
    <div class="row g-3 align-items-end">

        <div class="col-md-4">
            <label asp-for="SearchVm.Keyword" class="form-label">Tìm kiếm</label>
            <input asp-for="SearchVm.Keyword" class="form-control" placeholder="Tên hoặc mô tả sự kiện..." maxlength="200" />
            <span asp-validation-for="SearchVm.Keyword" class="text-danger small"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="SearchVm.CategoryId" class="form-label">Danh mục</label>
            <select asp-for="SearchVm.CategoryId" class="form-select">
                <option value="">Tất cả danh mục</option>
                @foreach (var cat in Model.SearchVm.Categories)
                {
                    <option value="@cat.Id" selected="@(Model.SearchVm.CategoryId == cat.Id)">@cat.Name</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="SearchVm.TimeFilter" class="form-label">Thời gian</label>
            <select asp-for="SearchVm.TimeFilter" class="form-select">
                <option value="">Tất cả</option>
                <option value="Upcoming">Sắp diễn ra</option>
                <option value="Ongoing">Đang diễn ra</option>
                <option value="Past">Đã kết thúc</option>
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Tìm</button>
        </div>

    </div>

    @if (Model.SearchVm.Tags.Count > 0)
    {
        <div class="mt-3">
            <label class="form-label">Tags</label>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var tag in Model.SearchVm.Tags)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               name="SearchVm.TagIds" value="@tag.Id"
                               id="tag_@tag.Id"
                               @(Model.SearchVm.TagIds.Contains(tag.Id) ? "checked" : "") />
                        <label class="form-check-label" for="tag_@tag.Id">@tag.Name</label>
                    </div>
                }
            </div>
        </div>
    }
</form>

@if (Model.SearchVm.Results.Count == 0)
{
    <div class="alert alert-secondary">Không tìm thấy sự kiện phù hợp.</div>
}
else
{
    <p class="text-muted">
        Trang @Model.SearchVm.PageNumber / @Model.SearchVm.TotalPages
        (@Model.SearchVm.TotalCount kết quả)
    </p>

    <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
        @foreach (var card in Model.SearchVm.Results)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@(string.IsNullOrEmpty(card.BannerUrl) ? "/images/placeholder.jpg" : card.BannerUrl)"
                         class="card-img-top" alt="@card.Title" style="height:180px;object-fit:cover;" />
                    <div class="card-body">
                        <h5 class="card-title">@card.Title</h5>
                        <p class="card-text text-muted small">
                            <i class="bi bi-calendar-event"></i>
                            @card.StartTime.ToString("dd/MM/yyyy HH:mm")
                        </p>
                        <p class="card-text text-muted small">
                            <i class="bi bi-geo-alt"></i> @card.VenueName
                        </p>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var tag in card.TagNames)
                            {
                                <span class="badge bg-secondary">@tag</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a asp-page="/Events/Detail" asp-route-id="@card.Id" class="btn btn-outline-primary btn-sm w-100">
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @* Pagination — giữ nguyên tất cả filter params khi chuyển trang *@
    <nav aria-label="Phân trang">
        <ul class="pagination justify-content-center">
            @if (Model.SearchVm.PageNumber > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-page="./Index"
                       asp-route-SearchVm.Keyword="@Model.SearchVm.Keyword"
                       asp-route-SearchVm.CategoryId="@Model.SearchVm.CategoryId"
                       asp-route-SearchVm.TimeFilter="@Model.SearchVm.TimeFilter"
                       asp-route-SearchVm.PageNumber="@(Model.SearchVm.PageNumber - 1)">
                        &laquo; Trước
                    </a>
                </li>
            }
            @if (Model.SearchVm.PageNumber < Model.SearchVm.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-page="./Index"
                       asp-route-SearchVm.Keyword="@Model.SearchVm.Keyword"
                       asp-route-SearchVm.CategoryId="@Model.SearchVm.CategoryId"
                       asp-route-SearchVm.TimeFilter="@Model.SearchVm.TimeFilter"
                       asp-route-SearchVm.PageNumber="@(Model.SearchVm.PageNumber + 1)">
                        Sau &raquo;
                    </a>
                </li>
            }
        </ul>
    </nav>
}
