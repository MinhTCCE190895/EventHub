@page
@model RazorPages.Pages.Tags.EditModel
@{
    ViewData["Title"] = "Edit Tag";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-page="Index" class="text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h3 class="fw-bold mb-0">Edit Tag</h3>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="TagUpdateDTO.Id" />
                        
                        <div class="mb-3">
                            <label asp-for="TagUpdateDTO.Name" class="form-label fw-medium"></label>
                            <input asp-for="TagUpdateDTO.Name" class="form-control" placeholder="Enter tag name" />
                            <span asp-validation-for="TagUpdateDTO.Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="TagUpdateDTO.Description" class="form-label fw-medium"></label>
                            <textarea asp-for="TagUpdateDTO.Description" class="form-control" rows="4" placeholder="Enter tag description"></textarea>
                            <span asp-validation-for="TagUpdateDTO.Description" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-page="Index" class="btn btn-light">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
