@page
@model RazorPages.Pages.Tags.DeleteModel
@{
    ViewData["Title"] = "Xóa thẻ tag";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-page="Index" class="text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 border-danger border-opacity-25">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h3 class="fw-bold text-danger mb-0">Xóa thẻ tag</h3>
                </div>
                <div class="card-body p-4">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-x-circle-fill me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                        <div>
                            Bạn có chắc chắn muốn xóa thẻ tag này không? Hành động này <strong>không thể hoàn tác</strong>.
                        </div>
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">ID</dt>
                        <dd class="col-sm-9">@Model.TagDTO.Id</dd>

                        <dt class="col-sm-3 text-muted">Tên</dt>
                        <dd class="col-sm-9 fw-medium">@Model.TagDTO.Name</dd>

                        <dt class="col-sm-3 text-muted">Mô tả</dt>
                        <dd class="col-sm-9">
                            @if (string.IsNullOrEmpty(Model.TagDTO.Description))
                            {
                                <span class="text-muted fst-italic">Chưa có mô tả</span>
                            }
                            else
                            {
                                @Model.TagDTO.Description
                            }
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light border-top-0 py-3">
                    <form method="post">
                        <input type="hidden" asp-for="TagDTO.Id" />
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-page="./Index" class="btn btn-light px-4">Hủy</a>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash me-1"></i> Xác nhận xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
