@page
@model RazorPages.Pages.Requests.IndexModel
@{
    ViewData["Title"] = "Quản lý Đề xuất Ý tưởng Sự kiện";
    var isStudent = User.IsInRole("Student");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-lightbulb-fill text-warning me-2"></i>@(isStudent ? "Ý tưởng sự kiện của tôi" : "Duyệt ý tưởng sự kiện")</h2>
            <p class="text-muted mb-0">@(isStudent ? "Đề xuất các ý tưởng sự kiện mới và theo dõi trạng thái phê duyệt từ ban tổ chức." : "Xem xét và phê duyệt các ý tưởng sự kiện được đề xuất bởi sinh viên.")</p>
        </div>
        @if (isStudent)
        {
            <a asp-page="./Create" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm fw-semibold">
                <i class="bi bi-plus-lg me-1"></i> Đề xuất ý tưởng mới
            </a>
        }
    </div>

    @if (!isStudent)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-3">
                <form method="get" class="d-flex align-items-center gap-3">
                    <label class="fw-semibold text-muted mb-0"><i class="bi bi-funnel me-1"></i> Lọc theo trạng thái:</label>
                    <select asp-for="StatusFilter" class="form-select form-select-sm w-auto rounded-3" onchange="this.form.submit()">
                        <option value="">Tất cả</option>
                        <option value="Pending">Chờ duyệt (Pending)</option>
                        <option value="Approved">Đã duyệt (Approved)</option>
                        <option value="Rejected">Từ chối (Rejected)</option>
                    </select>
                </form>
            </div>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3">#</th>
                        <th class="py-3">Chủ đề ý tưởng</th>
                        @if (!isStudent)
                        {
                            <th class="py-3">Người đề xuất</th>
                        }
                        <th class="py-3">Ngày gửi</th>
                        <th class="py-3">Trạng thái</th>
                        <th class="py-3">Phản hồi từ BTC</th>
                        @if (!isStudent)
                        {
                            <th class="pe-4 py-3 text-end">Thao tác</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Requests.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Chưa có đề xuất ý tưởng nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int index = 1;
                        foreach (var item in Model.Requests)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-muted">@(index++)</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Topic</div>
                                    <small class="text-muted d-block text-truncate" style="max-width: 350px;">@item.Description</small>
                                </td>
                                @if (!isStudent)
                                {
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-person-fill me-1"></i>@item.StudentName
                                        </span>
                                    </td>
                                }
                                <td class="text-nowrap">@item.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @item.StatusBadgeClass px-3 py-1 rounded-pill">
                                        <i class="bi @item.StatusIconClass me-1"></i>@item.StatusDisplayName
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ResponseMessage))
                                    {
                                        <span class="text-dark small"><i class="bi bi-chat-quote me-1 text-primary"></i>@item.ResponseMessage</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Chưa có phản hồi</span>
                                    }
                                </td>
                                @if (!isStudent)
                                {
                                    <td class="pe-4 text-end">
                                        <a asp-page="./Process" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="bi bi-pencil-square me-1"></i> Xử lý
                                        </a>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
