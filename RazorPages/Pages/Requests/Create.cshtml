@page
@model RazorPages.Pages.Requests.CreateModel
@{
    ViewData["Title"] = "Đề xuất Ý tưởng Sự kiện mới";
}

<div class="container py-4" style="max-width: 750px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-lightbulb-fill text-warning me-2"></i>Đề xuất Ý tưởng Sự kiện</h2>
            <p class="text-muted mb-0">Chia sẻ ý tưởng của bạn để ban tổ chức xem xét và tổ chức trong tương lai.</p>
        </div>
        <a asp-page="./Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="card border-0 shadow rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5">
            <form method="post">
                <div class="mb-4">
                    <label asp-for="Input.Topic" class="form-label fw-bold">Chủ đề ý tưởng <span class="text-danger">*</span></label>
                    <input asp-for="Input.Topic" class="form-control form-control-lg rounded-3" placeholder="Ví dụ: Hội thảo trí tuệ nhân tạo GenAI trong học tập..." />
                    <span asp-validation-for="Input.Topic" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.Description" class="form-label fw-bold">Mô tả chi tiết ý tưởng <span class="text-danger">*</span></label>
                    <textarea asp-for="Input.Description" class="form-control rounded-3" rows="6" placeholder="Trình bày mục đích, đối tượng tham dự mong muốn, quy mô hoặc các diễn giả đề xuất..."></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                    <a asp-page="./Index" class="btn btn-light px-4 py-2 rounded-pill fw-semibold">Hủy</a>
                    <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill fw-semibold shadow-sm">
                        <i class="bi bi-send-fill me-1"></i> Gửi đề xuất
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
