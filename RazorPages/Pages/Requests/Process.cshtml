@page "{id:int}"
@model RazorPages.Pages.Requests.ProcessModel
@{
    ViewData["Title"] = "Xử lý Ý tưởng Sự kiện";
}

<div class="container py-4" style="max-width: 800px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-pencil-square text-primary me-2"></i>Duyệt Ý tưởng Sự kiện</h2>
            <p class="text-muted mb-0">Xem xét chi tiết và đưa ra quyết định phê duyệt hoặc từ chối ý tưởng.</p>
        </div>
        <a asp-page="./Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    @if (Model.RequestDetail != null)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h4 class="fw-bold text-dark mb-0">@Model.RequestDetail.Topic</h4>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">
                        <i class="bi bi-person-fill me-1"></i>@Model.RequestDetail.StudentName
                    </span>
                </div>
                <div class="text-muted mb-3" style="white-space: pre-wrap; font-size: 0.95rem;">@Model.RequestDetail.Description</div>
                <div class="small text-muted border-top pt-3 d-flex justify-content-between">
                    <span><i class="bi bi-clock me-1"></i>Ngày gửi: @Model.RequestDetail.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    <span>Trạng thái hiện tại: <strong>@Model.RequestDetail.Status</strong></span>
                </div>
            </div>
        </div>
    }

    <div class="card border-0 shadow rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5">
            <form method="post">
                <input type="hidden" asp-for="Input.Id" />

                <div class="mb-4">
                    <label asp-for="Input.Status" class="form-label fw-bold">Quyết định phê duyệt <span class="text-danger">*</span></label>
                    <select asp-for="Input.Status" class="form-select form-select-lg rounded-3">
                        <option value="Approved">Đồng ý phê duyệt (Approved)</option>
                        <option value="Rejected">Từ chối (Rejected)</option>
                        <option value="Pending">Tiếp tục xem xét (Pending)</option>
                    </select>
                    <span asp-validation-for="Input.Status" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ResponseMessage" class="form-label fw-bold">Phản hồi từ Ban tổ chức</label>
                    <textarea asp-for="Input.ResponseMessage" class="form-control rounded-3" rows="4" placeholder="Nhập lý do phê duyệt hoặc từ chối, lời khuyên cho sinh viên..."></textarea>
                    <span asp-validation-for="Input.ResponseMessage" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                    <a asp-page="./Index" class="btn btn-light px-4 py-2 rounded-pill fw-semibold">Hủy</a>
                    <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill fw-semibold shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Lưu kết quả
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
