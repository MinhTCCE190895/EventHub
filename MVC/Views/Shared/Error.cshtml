@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<div class="container py-5">
    <div class="card border-0 shadow-sm rounded-4 mx-auto error-card text-center">
        <div class="card-body p-5">
            <i class="bi bi-exclamation-triangle-fill text-danger error-icon"></i>
            <h1 class="h3 fw-bold mt-3">Không thể xử lý yêu cầu</h1>
            <p class="text-muted">Hệ thống đang gặp sự cố tạm thời. Vui lòng thử lại sau.</p>
            @if (Model.ShowRequestId)
            {
                <p class="small text-muted">Mã yêu cầu: <code>@Model.RequestId</code></p>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-3 px-4">
                Quay về trang chủ
            </a>
        </div>
    </div>
</div>
