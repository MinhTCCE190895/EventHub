@using System.Security.Claims
@using Microsoft.Extensions.Options
@using MVC.Configurations
@inject IOptions<PortalOptions> PortalOptionsAccessor
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var useTopNavbar = currentController == "Account";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name;
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value;
    var userInitial = string.IsNullOrWhiteSpace(userName) ? "U" : userName[0].ToString().ToUpperInvariant();
    var portalOptions = PortalOptionsAccessor.Value;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniEvent Hub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVC.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-container @(useTopNavbar ? "layout-top-nav" : "")">
        <aside class="app-sidebar">
            <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shield-check text-primary"></i> UniEvent Hub
            </a>
            
            <nav class="sidebar-nav">
                <a class="sidebar-link" href="@portalOptions.GetRazorPagesUrl()">
                    <i class="bi bi-compass-fill"></i> Khám phá sự kiện
                </a>
                
                @if (isAuthenticated && (User.IsInRole(ApplicationRoles.Admin) || User.IsInRole(ApplicationRoles.Organizer)))
                {
                    <a class="sidebar-link" href="@portalOptions.GetBlazorUrl()">
                        <i class="bi bi-activity"></i> Live Dashboard
                    </a>
                    
                    <a class="sidebar-link" href="@portalOptions.GetRazorPagesUrl("Events")">
                        <i class="bi bi-calendar-event-fill"></i> Quản lý sự kiện
                    </a>
                    <a class="sidebar-link" href="@portalOptions.GetRazorPagesUrl("Categories")">
                        <i class="bi bi-tags-fill"></i> Quản lý danh mục
                    </a>
                    <a class="sidebar-link" href="@portalOptions.GetRazorPagesUrl("Tags")">
                        <i class="bi bi-hash"></i> Quản lý Thẻ
                    </a>
                    <a class="sidebar-link" href="@portalOptions.GetRazorPagesUrl("Venues")">
                        <i class="bi bi-building"></i> Quản lý địa điểm
                    </a>
                    <a class="sidebar-link" href="@portalOptions.GetRazorPagesUrl("Requests")">
                        <i class="bi bi-lightbulb-fill"></i> Duyệt ý tưởng sự kiện
                    </a>
                    <a class="sidebar-link" href="@portalOptions.GetBlazorUrl("feedback-analytics")">
                        <i class="bi bi-bar-chart-line-fill"></i> Phân tích đánh giá
                    </a>
                }

                @if (isAuthenticated && User.IsInRole(ApplicationRoles.Admin))
                {
                    <a class="sidebar-link @(currentController == "Admin" && currentAction == "Users" ? "active" : "")" asp-controller="Admin" asp-action="Users">
                        <i class="bi bi-people-fill"></i> Quản lý User
                    </a>
                }
                
                <a class="sidebar-link" href="@portalOptions.GetRazorPagesUrl("Privacy")">
                    <i class="bi bi-shield-lock-fill"></i> Riêng tư
                </a>
            </nav>

            <div class="mt-auto pt-3 border-top border-light">
                @if (isAuthenticated)
                {
                    <div class="d-flex align-items-center gap-3 mb-3 p-2 rounded-3 bg-light">
                        <div class="user-avatar user-avatar-lg bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold">
                            @userInitial
                        </div>
                        <div class="user-summary overflow-hidden">
                            <div class="fw-bold text-truncate text-sm" title="@userName">@userName</div>
                            <span class="user-role-badge badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold mt-1">@userRole</span>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                        <button type="submit" class="btn btn-outline-danger w-100 btn-sm rounded-3 py-2 fw-semibold">
                            <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                        </button>
                    </form>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm rounded-3 py-2 fw-semibold text-white">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-sm rounded-3 py-2 fw-semibold">
                            <i class="bi bi-person-plus me-1"></i> Đăng ký
                        </a>
                    </div>
                }
            </div>
        </aside>

        <div class="app-content">
            @if (useTopNavbar)
            {
                <header class="app-navbar-top">
                    <div class="navbar-top-container">
                        <a class="navbar-top-brand" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-shield-check"></i> UniEvent Hub
                        </a>
                        <div class="navbar-top-actions">
                            @if (isAuthenticated)
                            {
                                @if (User.IsInRole(ApplicationRoles.Admin))
                                {
                                    <a class="navbar-top-link" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-speedometer2"></i> Admin Panel
                                    </a>
                                }
                                <div class="d-flex align-items-center gap-2 border-start ps-3">
                                    <span class="fw-semibold text-dark text-sm">Chào, @userName</span>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-1" title="Đăng xuất">
                                            <i class="bi bi-power fs-5"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <a class="navbar-top-link" asp-controller="Account" asp-action="Login">
                                    Đăng nhập
                                </a>
                                <a class="btn btn-primary btn-sm rounded-pill px-3 py-1.5 fw-semibold text-white text-decoration-none" asp-controller="Account" asp-action="Register">
                                    Đăng ký
                                </a>
                            }
                        </div>
                    </div>
                </header>
            }
            else
            {
                <header class="d-lg-none bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                    <a class="sidebar-brand mb-0 fs-5" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-shield-check text-primary"></i> UniEvent Hub
                    </a>
                    <button class="btn btn-outline-primary btn-sm border-0" type="button" data-sidebar-toggle aria-label="Mở menu điều hướng">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                </header>
            }

            <main class="content-body">
                @RenderBody()
            </main>

            <footer class="content-footer d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <div>
                    &copy; 2026 - <strong>UniEvent Hub Team</strong>.
                </div>
                <div class="d-flex gap-3">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted">Chính sách bảo mật</a>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
