@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var useTopNavbar = currentController == "Account" || (currentController == "Home" && currentAction == "Index");
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name;
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value;
    var userEmail = User.FindFirst(ClaimTypes.Email)?.Value;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniEvent Hub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVC.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-container @(useTopNavbar ? "layout-top-nav" : "")">
        <!-- Sleek Left Sidebar -->
        <aside class="app-sidebar">
            <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shield-check text-primary"></i> UniEvent Hub
            </a>
            
            <nav class="sidebar-nav">
                <!-- Chỉ giữ các liên kết trỏ nội bộ MVC hoặc mock để không bấm nhảy sang RazorPages -->
                <a class="sidebar-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-compass-fill"></i> Khám phá
                </a>
                <a class="sidebar-link" href="#" onclick="alert('Tính năng Bookmarks thuộc phân hệ RazorPages (FE-11)'); return false;">
                    <i class="bi bi-bookmark-heart-fill"></i> Bookmarks
                </a>
                <a class="sidebar-link" href="#" onclick="alert('Tính năng Organizers thuộc phân hệ RazorPages (FE-02)'); return false;">
                    <i class="bi bi-person-badge-fill"></i> Organizers
                </a>

                @if (userRole == "Admin")
                {
                    <a class="sidebar-link @(currentController == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Admin Panel
                    </a>
                }
            </nav>

            <!-- User Auth status block inside Sidebar -->
            <div class="mt-auto pt-3 border-top border-light">
                @if (isAuthenticated)
                {
                    <div class="d-flex align-items-center gap-3 mb-3 p-2 rounded-3 bg-light">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 1.1rem;">
                            @(userName?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <div class="overflow-hidden" style="line-height: 1.2;">
                            <div class="fw-bold text-truncate" style="font-size: 0.9rem;" title="@userName">@userName</div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold mt-1" style="font-size: 0.7rem; padding: 2px 6px;">@userRole</span>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger w-100 btn-sm rounded-3 py-2 fw-semibold">
                            <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                        </button>
                    </form>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm rounded-3 py-2 fw-semibold text-white">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-sm rounded-3 py-2 fw-semibold">
                            <i class="bi bi-person-plus me-1"></i> Đăng ký
                        </a>
                    </div>
                }
            </div>

            <div class="sidebar-footer mt-3">
                <div>&copy; 2026 - UniEvent Hub</div>
            </div>
        </aside>

        <!-- Main Content Wrapper -->
        <div class="app-content">
            @if (useTopNavbar)
            {
                <!-- Sleek Top Navbar for Auth Pages and Home Page -->
                <header class="app-navbar-top">
                    <div class="navbar-top-container">
                        <a class="navbar-top-brand" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-shield-check"></i> UniEvent Hub
                        </a>
                        <div class="navbar-top-actions">
                            @if (isAuthenticated)
                            {
                                @if (userRole == "Admin")
                                {
                                    <a class="navbar-top-link" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-speedometer2"></i> Admin Panel
                                    </a>
                                }
                                <div class="d-flex align-items-center gap-2 border-start ps-3">
                                    <span class="fw-semibold text-dark" style="font-size: 0.9rem;">Chào, @userName</span>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-1" title="Đăng xuất">
                                            <i class="bi bi-power fs-5"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <a class="navbar-top-link" asp-controller="Account" asp-action="Login">
                                    Đăng nhập
                                </a>
                                <a class="btn btn-primary btn-sm rounded-pill px-3 py-1.5 fw-semibold text-white text-decoration-none" asp-controller="Account" asp-action="Register">
                                    Đăng ký
                                </a>
                            }
                        </div>
                    </div>
                </header>
            }
            else
            {
                <!-- Mobile Toggle Header (Visible only on smaller screens) -->
                <header class="d-lg-none bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                    <a class="sidebar-brand mb-0 fs-5" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-shield-check text-primary"></i> UniEvent Hub
                    </a>
                    <button class="btn btn-outline-primary btn-sm border-0" type="button" onclick="toggleSidebar()">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                </header>
            }

            <main class="content-body">
                @RenderBody()
            </main>

            <footer class="content-footer d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <div>
                    &copy; 2026 - <strong>UniEvent Hub Team</strong>.
                </div>
                <div class="d-flex gap-3">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted">Chính sách bảo mật</a>
                    <span class="text-muted">|</span>
                    <span class="text-primary fw-bold">FE-01 Identity & Authorization</span>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function toggleSidebar() {
            const sidebar = document.querySelector('.app-sidebar');
            sidebar.classList.toggle('show');
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
