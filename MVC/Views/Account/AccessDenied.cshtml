@{
    ViewData["Title"] = "Từ chối truy cập";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-wrapper">
    <div class="auth-card auth-card-compact text-center">
        <div class="access-denied-icon text-danger mb-3">
            <i class="bi bi-shield-slash-fill"></i>
        </div>
        <h2 class="auth-title mb-2">Không có quyền truy cập</h2>
        <p class="auth-subtitle mb-4">
            Tài khoản của bạn không được phân quyền để xem trang này. Vui lòng liên hệ với quản trị viên nếu bạn nghĩ đây là một sự nhầm lẫn.
        </p>

        <div class="d-flex flex-column gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn-primary-minimal text-decoration-none">
                <i class="bi bi-house-door-fill me-1"></i> Quay về trang chủ
            </a>
            <form asp-action="Logout" method="post">
                <button type="submit" class="btn btn-link text-muted text-decoration-none text-sm">
                    Đăng nhập bằng tài khoản khác
                </button>
            </form>
        </div>
    </div>
</div>
