@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="auth-wrapper">
    <div class="auth-card text-center" style="max-width: 460px;">
        <div class="text-danger mb-3" style="font-size: 3.5rem;">
            <i class="bi bi-shield-slash-fill"></i>
        </div>
        <h2 class="auth-title mb-2">Không có quyền truy cập</h2>
        <p class="auth-subtitle mb-4">
            Tài khoản của bạn không được phân quyền để xem trang này. Vui lòng liên hệ với quản trị viên nếu bạn nghĩ đây là một sự nhầm lẫn.
        </p>

        <div class="d-flex flex-column gap-2">
            <a href="/" class="btn-primary-minimal text-decoration-none">
                <i class="bi bi-house-door-fill me-1"></i> Quay về trang chủ
            </a>
            <form asp-action="Logout" method="post">
                <button type="submit" class="btn btn-link text-muted text-decoration-none" style="font-size: 0.9rem;">
                    Đăng nhập bằng tài khoản khác
                </button>
            </form>
        </div>
    </div>
</div>
