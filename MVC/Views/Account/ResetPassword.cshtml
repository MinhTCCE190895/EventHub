@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle p-3 mb-3">
                            <i class="bi bi-shield-lock-fill fs-3"></i>
                        </div>
                        <h4 class="fw-bold">Đặt lại mật khẩu</h4>
                        <p class="text-muted small">Nhập mã OTP vừa nhận qua email và thiết lập mật khẩu mới cho tài khoản của bạn.</p>
                    </div>

                    <partial name="_Alerts" />

                    <form asp-action="ResetPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Địa chỉ Email</label>
                            <input asp-for="Email" class="form-control bg-light" readonly autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Otp" class="form-label fw-semibold">Mã xác thực OTP (6 chữ số)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-check text-muted"></i></span>
                                <input asp-for="Otp"
                                       class="form-control bg-light border-start-0 ps-0 text-center fs-5 fw-bold otp-input"
                                       placeholder="123456"
                                       maxlength="6"
                                       inputmode="numeric"
                                       autocomplete="one-time-code" />
                            </div>
                            <span asp-validation-for="Otp" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold">Mật khẩu mới</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                                <input asp-for="NewPassword" class="form-control bg-light border-start-0 ps-0" placeholder="••••••••" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock-fill text-muted"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control bg-light border-start-0 ps-0" placeholder="••••••••" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2 rounded-3 fw-semibold shadow-sm mb-3">
                            Xác nhận Đặt lại mật khẩu
                        </button>

                        <div class="text-center">
                            <a asp-action="Login" class="text-decoration-none text-muted small">
                                <i class="bi bi-arrow-left me-1"></i> Hủy và quay lại Đăng nhập
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
