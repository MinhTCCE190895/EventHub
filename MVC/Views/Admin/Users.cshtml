@model MVC.ViewModels.AdminUsersViewModel

@{
    ViewData["Title"] = "Quản lý User";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Quản lý User
            </h1>
            <p class="text-muted mb-0">Danh sách tất cả tài khoản trong hệ thống</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-primary rounded-3 px-3 py-2 fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
    </div>

    @* ── Thông báo Toast ── *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* ── Bảng danh sách User ── *@
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom-0 py-3 px-4">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-list-ul me-2 text-primary"></i>Tất cả User
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2 fw-semibold" style="font-size:.75rem;">@Model.Users.Count</span>
                </h5>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width:5%;">#</th>
                            <th style="width:20%;">Họ tên</th>
                            <th style="width:20%;">Email</th>
                            <th style="width:10%;">MSSV</th>
                            <th style="width:8%;">Vai trò</th>
                            <th style="width:8%;">Trạng thái</th>
                            <th style="width:7%;">Events</th>
                            <th style="width:7%;">Bookings</th>
                            <th style="width:10%;">Ngày tạo</th>
                            <th style="width:5%;" class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int index = 1; }
                        @foreach (var user in Model.Users)
                        {
                            <tr class="@(!user.IsActive ? "table-danger bg-opacity-10" : "")">
                                <td class="ps-4 text-muted">@index</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="@(user.IsActive ? "bg-primary" : "bg-secondary") text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:34px;height:34px;font-size:.85rem;">
                                            @user.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="fw-semibold">@user.FullName</span>
                                    </div>
                                </td>
                                <td class="text-muted" style="font-size:.85rem;">@user.Email</td>
                                <td class="text-muted" style="font-size:.85rem;">@(user.StudentCode ?? "—")</td>
                                <td>
                                    @{
                                        var roleBadgeClass = user.Role switch
                                        {
                                            "Admin" => "bg-danger-subtle text-danger border-danger-subtle",
                                            "Organizer" => "bg-primary-subtle text-primary border-primary-subtle",
                                            _ => "bg-secondary-subtle text-secondary border-secondary-subtle"
                                        };
                                    }
                                    <span class="badge @roleBadgeClass border fw-semibold" style="font-size:.75rem;">@user.Role</span>
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold" style="font-size:.75rem;">
                                            <i class="bi bi-check-circle-fill me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold" style="font-size:.75rem;">
                                            <i class="bi bi-lock-fill me-1"></i>Bị khóa
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border fw-semibold">@user.EventCount</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border fw-semibold">@user.BookingCount</span>
                                </td>
                                <td class="text-muted" style="font-size:.85rem;">@user.CreatedAt.AddHours(7).ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    @if (user.Role != "Admin")
                                    {
                                        <form asp-action="ToggleUserActive" asp-route-id="@user.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            @if (user.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger border-0 rounded-2 px-2 py-1"
                                                        title="Khóa tài khoản"
                                                        onclick="return confirm('Bạn có chắc muốn KHÓA tài khoản @user.FullName?')">
                                                    <i class="bi bi-lock-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success border-0 rounded-2 px-2 py-1"
                                                        title="Mở khóa tài khoản"
                                                        onclick="return confirm('Bạn có chắc muốn MỞ KHÓA tài khoản @user.FullName?')">
                                                    <i class="bi bi-unlock-fill"></i>
                                                </button>
                                            }
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted" title="Không thể khóa tài khoản Admin"><i class="bi bi-shield-lock"></i></span>
                                    }
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Tự động ẩn alert sau 4 giây
        setTimeout(function () {
            document.querySelectorAll('.alert').forEach(function (el) {
                var bsAlert = new bootstrap.Alert(el);
                bsAlert.close();
            });
        }, 4000);
    </script>
}
