@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-speedometer2 text-primary me-2"></i>Admin Dashboard
            </h1>
            <p class="text-muted mb-0">Tổng quan hệ thống UniEvent Hub</p>
        </div>
        <a asp-action="Users" class="btn btn-primary rounded-3 px-4 py-2 fw-semibold">
            <i class="bi bi-people-fill me-1"></i> Quản lý User
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="admin-stat-icon bg-primary bg-opacity-10 text-primary rounded-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted text-xs">Tổng User</div>
                        <div class="fs-4 fw-bold">@Model.TotalUsers</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="admin-stat-icon bg-success bg-opacity-10 text-success rounded-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-calendar-event-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted text-xs">Tổng Sự kiện</div>
                        <div class="fs-4 fw-bold">@Model.TotalEvents</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="admin-stat-icon bg-info bg-opacity-10 text-info rounded-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-ticket-perforated-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted text-xs">Tổng Booking</div>
                        <div class="fs-4 fw-bold">@Model.TotalBookings</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="admin-stat-icon bg-warning bg-opacity-10 text-warning rounded-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-person-plus-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted text-xs">User mới (7 ngày)</div>
                        <div class="fs-4 fw-bold">@Model.NewUsersLast7Days</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center py-3 px-4">
            <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>User mới nhất</h5>
            <a asp-action="Users" class="text-primary text-decoration-none fw-semibold text-sm">
                Xem tất cả <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Họ tên</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentUsers.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-5">Chưa có tài khoản nào.</td>
                            </tr>
                        }
                        @foreach (var user in Model.RecentUsers)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="user-avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold">
                                            @user.Initial
                                        </div>
                                        <span class="fw-semibold">@user.FullName</span>
                                    </div>
                                </td>
                                <td class="text-muted">@user.Email</td>
                                <td>
                                    <span class="badge @user.RoleBadgeClass border fw-semibold text-xxs">@user.Role</span>
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold text-xxs">
                                            <i class="bi bi-check-circle-fill me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold text-xxs">
                                            <i class="bi bi-lock-fill me-1"></i>Bị khóa
                                        </span>
                                    }
                                </td>
                                <td class="text-muted text-sm">
                                    <time datetime="@user.CreatedAtUtcIso" data-local-datetime>@user.CreatedAtUtcDisplay</time>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
