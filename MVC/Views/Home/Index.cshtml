@{
    ViewData["Title"] = "Bắt đầu - UniEvent Hub";
}

<div class="home-hero d-flex flex-column align-items-center justify-content-center text-center">
    <div class="mb-5">
        <div class="home-hero-icon text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm">
            <i class="bi bi-shield-check"></i>
        </div>

        <span class="home-eyebrow d-block text-primary fw-bold text-uppercase mb-2">
            Cổng xác thực UniEvent Hub
        </span>

        <h1 class="home-title text-dark mb-3">
            Kết nối & Khám phá <span class="text-primary">Sự kiện</span>
        </h1>

        <p class="home-description text-muted mx-auto">
            Chào mừng bạn đến với hệ thống quản lý sự kiện nội bộ. Đăng nhập bằng tài khoản sinh viên hoặc ban tổ chức để khám phá sự kiện, đặt chỗ và quản lý hoạt động của bạn.
        </p>
    </div>

    <div class="home-actions d-flex flex-column flex-sm-row gap-3 w-100 justify-content-center">
        <a asp-controller="Account" asp-action="Login" class="card-portal-minimal flex-fill text-decoration-none">
            <div class="portal-icon">
                <i class="bi bi-box-arrow-in-right"></i>
            </div>
            <div class="portal-info text-start">
                <span class="portal-title">Đăng nhập</span>
                <span class="portal-desc">Truy cập tài khoản của bạn</span>
            </div>
        </a>

        <a asp-controller="Account" asp-action="Register" class="card-portal-minimal flex-fill text-decoration-none">
            <div class="portal-icon portal-icon-secondary">
                <i class="bi bi-person-plus"></i>
            </div>
            <div class="portal-info text-start">
                <span class="portal-title">Đăng ký</span>
                <span class="portal-desc">Tạo tài khoản sinh viên</span>
            </div>
        </a>
    </div>
</div>
