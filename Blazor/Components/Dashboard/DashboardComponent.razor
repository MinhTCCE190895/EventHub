@page "/"
@page "/dashboard"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Authorization
@using DAL.Data
@using DAL.Entities
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@inject AppDbContext DbContext
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="dashboard-container">
    <div class="dashboard-content">
        <div class="page-header-minimal d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
            <div>
                <span class="page-badge-minimal">Phân tích thời gian thực</span>
                <h1 class="display-5 fw-bold mt-1">Bảng Giám Sát Hoạt Động Trực Tuyến</h1>
            </div>
            <div class="d-flex align-items-center bg-white px-3 py-2 rounded-pill border border-secondary border-opacity-25">
                <span class="pulse-green"></span>
                <span class="text-success small fw-bold ms-2">ĐANG GIÁM SÁT TRỰC TIẾP</span>
            </div>
        </div>

        @if (IsLoading)
        {
            <!-- Skeleton Loader State -->
            <div class="kpi-grid">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="card-glass kpi-card">
                        <div class="kpi-info w-75">
                            <div class="skeleton-box mb-2" style="height: 14px; width: 40%;"></div>
                            <div class="skeleton-box" style="height: 32px; width: 60%;"></div>
                        </div>
                        <div class="skeleton-box" style="height: 52px; width: 52px; border-radius: 12px;"></div>
                    </div>
                }
            </div>

            <div class="main-grid">
                <div class="card-glass d-flex flex-column gap-3" style="min-height: 300px;">
                    <div class="skeleton-box" style="height: 24px; width: 30%;"></div>
                    <div class="skeleton-box flex-grow-1"></div>
                </div>
                <div class="card-glass d-flex flex-column gap-3" style="min-height: 300px;">
                    <div class="skeleton-box" style="height: 24px; width: 50%;"></div>
                    <div class="skeleton-box flex-grow-1"></div>
                </div>
            </div>
        }
        else
        {
            <!-- KPI Cards Section -->
            <div class="kpi-grid">
                <!-- Total Bookings KPI -->
                <div class="card-glass kpi-card">
                    <div class="kpi-info">
                        <span class="text-muted small fw-bold text-uppercase">Vé đã đặt (Trực tiếp)</span>
                        <h2 class="display-6 fw-bold mb-0 mt-1 glow-text-blue">
                            @TotalRegisteredCount
                        </h2>
                        <span class="text-success small mt-1">
                            <i class="bi bi-graph-up-arrow"></i> +@RecentBookingsCount giao dịch mới
                        </span>
                    </div>
                    <div class="kpi-icon-wrapper kpi-blue">
                        <i class="bi bi-ticket-perforated-fill"></i>
                    </div>
                </div>

                <!-- Fill Rate KPI -->
                <div class="card-glass kpi-card">
                    <div class="kpi-info">
                        <span class="text-muted small fw-bold text-uppercase">Tỷ lệ lấp đầy</span>
                        <h2 class="display-6 fw-bold mb-0 mt-1 glow-text-amber">
                            @FillRate.ToString("F1")%
                        </h2>
                        <span class="text-muted small mt-1">
                            Dung lượng: @TotalRegisteredCount/@TotalCapacity
                        </span>
                    </div>
                    <div class="kpi-icon-wrapper kpi-amber">
                        <i class="bi bi-pie-chart-fill"></i>
                    </div>
                </div>

                <!-- Booking Velocity KPI -->
                <div class="card-glass kpi-card">
                    <div class="kpi-info">
                        <span class="text-muted small fw-bold text-uppercase">Tốc độ đặt vé</span>
                        <h2 class="display-6 fw-bold mb-0 mt-1 glow-text-green">
                            @Velocity.ToString("F1") <span class="small fs-6 text-muted">vé/phút</span>
                        </h2>
                        <span class="text-success small mt-1">
                            <i class="bi bi-lightning-fill"></i> Hoạt động ổn định
                        </span>
                    </div>
                    <div class="kpi-icon-wrapper kpi-green">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                </div>
            </div>

            <!-- Main Layout Grid -->
            <div class="main-grid">
                <!-- Left Column: Charts and Progress -->
                <div class="d-flex flex-column gap-4">
                    <!-- Dynamic Live Trend Chart (SVG) -->
                    <div class="card-glass">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold mb-0">Biểu Đồ Xu Hướng Đặt Vé (Trực tiếp)</h5>
                            <span class="badge bg-primary bg-opacity-10 text-primary px-2.5 py-1 text-xs fw-semibold">10 cập nhật gần nhất</span>
                        </div>
                        
                        <div class="chart-wrapper">
                            <svg class="svg-chart" viewBox="0 0 500 200" preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="chart-gradient" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="var(--primary)" />
                                        <stop offset="100%" stop-color="var(--primary)" stop-opacity="0" />
                                    </linearGradient>
                                </defs>

                                <!-- Grid Lines -->
                                <line x1="0" y1="50" x2="500" y2="50" class="chart-grid" />
                                <line x1="0" y1="100" x2="500" y2="100" class="chart-grid" />
                                <line x1="0" y1="150" x2="500" y2="150" class="chart-grid" />

                                <!-- Area Path -->
                                <path d="@GetAreaPath()" class="chart-area" />

                                <!-- Line Path -->
                                <path d="@GetLinePath()" class="chart-line" />

                                <!-- Dots for data points -->
                                @for (int i = 0; i < ChartData.Count; i++)
                                {
                                    var (cx, cy) = GetPointCoords(i);
                                    var pt = ChartData[i];
                                    <circle cx="@cx.ToString(System.Globalization.CultureInfo.InvariantCulture)" cy="@cy.ToString(System.Globalization.CultureInfo.InvariantCulture)" r="4.5" class="chart-dot">
                                        <title>@pt.TooltipText</title>
                                    </circle>
                                }
                            </svg>
                        </div>
                    </div>

                    <!-- Live Event Seats Progress -->
                    <div class="card-glass">
                        <h5 class="fw-bold mb-4">Trạng Thái Vé Các Sự Kiện</h5>
                        <div class="event-progress-list">
                            @foreach (var ev in Events ?? new())
                            {
                                var remaining = ev.MaxCapacity - ev.RegisteredCount;
                                var progressPercentage = ev.MaxCapacity > 0 ? (ev.RegisteredCount * 100 / ev.MaxCapacity) : 0;
                                var isSoldOut = remaining <= 0;
                                var textClass = isSoldOut ? "text-danger" : (remaining <= 10 ? "text-warning" : "text-success");
                                var barColor = isSoldOut ? "bg-danger" : (remaining <= 10 ? "bg-warning" : "bg-primary");

                                <div class="event-progress-item">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-truncate" style="max-width: 60%;" title="@ev.Title">@ev.Title</span>
                                        <span class="@textClass fw-bold small">
                                            @(isSoldOut ? "Đã hết vé" : $"Còn {remaining} / {ev.MaxCapacity} chỗ")
                                        </span>
                                    </div>
                                    <div class="progress-bar-container">
                                        <div class="progress-bar-fill @barColor" style="width: @progressPercentage%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Right Column: Live Event Log -->
                <div class="card-glass d-flex flex-column h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">Nhật Ký Hoạt Động (Live Log)</h5>
                        <div class="spinner-grow spinner-grow-sm text-success" role="status"></div>
                    </div>
                    
                    <div class="log-container flex-grow-1">
                        @if (!LiveLogs.Any())
                        {
                            <p class="text-muted small text-center my-4">Chưa có nhật ký hoạt động nào...</p>
                        }
                        else
                        {
                            @foreach (var log in LiveLogs)
                            {
                                <div class="log-item">
                                    <div class="log-meta">
                                        <span class="badge @log.StatusClass">@log.StatusText</span>
                                        <span class="log-time">@log.Timestamp.ToString("HH:mm:ss")</span>
                                    </div>
                                    <div class="text-dark small mt-1" style="opacity: 0.85;">@log.Message</div>
                                    <div class="text-muted text-xs" style="font-size: 0.7rem;">Sự kiện: <span class="text-dark" style="opacity: 0.75;">@log.EventTitle</span></div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    // Danh sách các sự kiện đang diễn ra để theo dõi tiến trình chỗ trống
    private List<DashboardEventDto>? Events;

    // Đối tượng kết nối SignalR Client
    private HubConnection? hubConnection;

    // Trạng thái hiển thị Skeleton Loader khi đang tải dữ liệu ban đầu
    private bool IsLoading = true;

    // --- CÁC CHỈ SỐ KPI ĐO LƯỜNG ---
    // Tổng số vé đã được đăng ký thành công của tất cả các sự kiện
    private int TotalRegisteredCount = 0;

    // Tổng sức chứa tối đa của tất cả các sự kiện cộng lại
    private int TotalCapacity = 0;

    // Tỷ lệ lấp đầy ghế trống (%) = (Tổng số vé / Tổng sức chứa) * 100
    private double FillRate = 0;

    // Tốc độ đặt vé thực tế (vé/phút) calculated via exponential moving average
    private double Velocity = 0;

    // Số lượng giao dịch đặt vé phát sinh gần đây trong phiên giám sát
    private int RecentBookingsCount = 0;

    // Lớp chứa dữ liệu điểm đồ thị SVG để vẽ biểu đồ xu hướng
    public class ChartPointDto
    {
        public int Value { get; set; }
        public string TooltipText { get; set; } = string.Empty;
    }

    // Danh sách 10 điểm dữ liệu gần nhất hiển thị trên biểu đồ SVG Area Chart
    private List<ChartPointDto> ChartData = new();

    // Nhật ký hoạt động thời gian thực (Live Log) hiển thị ở thanh bên phải
    private List<ActivityLog> LiveLogs = new();

    // DTO tối giản đại diện cho sự kiện hiển thị trên Dashboard
    public class DashboardEventDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public int MaxCapacity { get; set; }
        public int RegisteredCount { get; set; }
    }

    // Cấu trúc một dòng log hoạt động thời gian thực
    public class ActivityLog
    {
        public string Message { get; set; } = string.Empty;
        public string EventTitle { get; set; } = string.Empty;
        public DateTime Timestamp { get; set; }
        public string StatusClass { get; set; } = "badge-success";
        public string StatusText { get; set; } = "THÀNH CÔNG";
    }

    // Vòng đời khởi tạo Dashboard: Nạp dữ liệu sự kiện, KPI ban đầu và lịch sử đặt vé gần đây
    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        await Task.Delay(800); // Giả lập thời gian load ban đầu cực nhanh tạo trải nghiệm mượt

        try
        {
            // Seed log hệ thống ban đầu báo hiệu trạng thái hoạt động
            LiveLogs.Add(new() { Message = "Hệ thống giám sát Live Dashboard khởi chạy thành công.", EventTitle = "Hệ Thống", Timestamp = DateTime.Now, StatusClass = "badge-success", StatusText = "HỆ THỐNG" });
            LiveLogs.Add(new() { Message = "Đang lắng nghe kết nối thời gian thực qua SignalR...", EventTitle = "SignalR", Timestamp = DateTime.Now.AddMilliseconds(-200), StatusClass = "badge-warning", StatusText = "ĐANG NGHE" });

            // 1. Tải danh sách các sự kiện đang Published và chưa kết thúc từ database
            var now = DateTime.UtcNow;
            Events = await DbContext.Events
                .Where(e => e.Status == "Published" && e.EndTime > now)
                .Select(e => new DashboardEventDto
                {
                    Id = e.Id,
                    Title = e.Title,
                    MaxCapacity = e.Venue.MaxCapacity,
                    RegisteredCount = e.RegisteredCount
                })
                .OrderBy(e => e.Title)
                .ToListAsync();

            // Tính toán chỉ số KPI ban đầu từ dữ liệu vừa tải
            CalculateKpis();

            // 2. Tải 10 confirmed bookings gần đây nhất kèm thông tin SV và Tên sự kiện làm điểm đồ thị ban đầu
            var recentBookings = await DbContext.Bookings
                .Where(b => b.Status == "Confirmed")
                .Include(b => b.Student)
                .Include(b => b.Event)
                .OrderByDescending(b => b.BookingTime)
                .Take(10)
                .ToListAsync();
            recentBookings.Reverse(); // Đảo lại theo thứ tự thời gian tăng dần để vẽ đồ thị từ trái qua phải

            // Tạo các mốc điểm ban đầu trên biểu đồ SVG (lùi dần từ tổng số vé hiện tại)
            ChartData = new List<ChartPointDto>();
            for (int i = 9; i >= 0; i--)
            {
                int val = TotalRegisteredCount - i;
                if (val < 0) val = 0;

                string tooltip = "Không có hoạt động";
                int bookingIndex = recentBookings.Count - 1 - i;
                if (bookingIndex >= 0 && bookingIndex < recentBookings.Count)
                {
                    var b = recentBookings[bookingIndex];
                    tooltip = $"Mới đặt - Học sinh: {b.Student?.FullName ?? "N/A"} | Sự kiện: {b.Event?.Title ?? "N/A"} ({b.BookingTime.ToLocalTime().ToString("HH:mm:ss")})";
                }

                ChartData.Add(new ChartPointDto
                {
                    Value = val,
                    TooltipText = tooltip
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi khởi tạo Dashboard: " + ex.Message);
            Events = new List<DashboardEventDto>();
        }
        finally
        {
            IsLoading = false;
        }
    }

    // Vòng đời sau khi render giao diện: Thiết lập kết nối SignalR thời gian thực để lắng nghe thay đổi
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Chạy ngầm tiến trình kết nối SignalR tránh nghẽn luồng render chính của trình duyệt
            _ = Task.Run(async () =>
            {
                try
                {
                    // Thiết lập SignalR Client kết nối đến Hub "/eventhub"
                    hubConnection = new HubConnectionBuilder()
                        .WithUrl(Navigation.ToAbsoluteUri("/eventhub"), options =>
                        {
                            options.HttpMessageHandlerFactory = (message) =>
                            {
                                if (message is HttpClientHandler clientHandler)
                                    clientHandler.ServerCertificateCustomValidationCallback += (sender, cert, chain, sslErrors) => true;
                                else if (message is SocketsHttpHandler socketsHandler)
                                    socketsHandler.SslOptions.RemoteCertificateValidationCallback += (sender, cert, chain, sslErrors) => true;
                                return message;
                            };
                        })
                        .WithAutomaticReconnect() // Tự động kết nối lại khi mất mạng
                        .Build();

                    // Đăng ký sự kiện lắng nghe cập nhật chỗ trống "ReceiveTicketUpdate" từ Server
                    hubConnection.On<Guid, int>("ReceiveTicketUpdate", async (eventId, remainingSeats) =>
                    {
                        // Xử lý cập nhật số liệu và trượt biểu đồ khi nhận được dữ liệu thời gian thực
                        await HandleTicketUpdateAsync(eventId, remainingSeats);
                    });

                    // Khởi động kết nối
                    await hubConnection.StartAsync();

                    await InvokeAsync(() =>
                    {
                        LiveLogs.Insert(0, new() { Message = "Đã thiết lập kết nối SignalR thành công.", EventTitle = "SignalR", Timestamp = DateTime.Now, StatusClass = "badge-success", StatusText = "ĐÃ KẾT NỐI" });
                        StateHasChanged();
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine("Lỗi khởi tạo SignalR (Dashboard): " + ex.Message);
                    await InvokeAsync(() =>
                    {
                        LiveLogs.Insert(0, new() { Message = $"Lỗi kết nối SignalR: {ex.Message}. Vui lòng kiểm tra lại dịch vụ.", EventTitle = "SignalR", Timestamp = DateTime.Now, StatusClass = "badge-danger", StatusText = "MẤT KẾT NỐI" });
                        StateHasChanged();
                    });
                }
            });
        }
    }

    // Tính toán lại các KPI chỉ số tổng quan trên Dashboard
    private void CalculateKpis()
    {
        if (Events != null)
        {
            TotalRegisteredCount = Events.Sum(e => e.RegisteredCount);
            TotalCapacity = Events.Sum(e => e.MaxCapacity);
            FillRate = TotalCapacity > 0 ? ((double)TotalRegisteredCount * 100 / TotalCapacity) : 0;
        }
    }

    // Xử lý cập nhật số liệu thời gian thực khi nhận được thông báo qua WebSocket (SignalR)
    private async Task HandleTicketUpdateAsync(Guid eventId, int remainingSeats)
    {
        if (Events == null) return;

        // Tìm sự kiện tương ứng trong danh sách Dashboard
        var ev = Events.FirstOrDefault(e => e.Id == eventId);
        if (ev != null)
        {
            int oldRegistered = ev.RegisteredCount;
            // Tính toán lại số lượng đăng ký hiện tại dựa trên số ghế trống Server trả về
            ev.RegisteredCount = ev.MaxCapacity - remainingSeats;
            int diff = ev.RegisteredCount - oldRegistered;

            // Chỉ cập nhật nếu thực sự có biến động số lượng vé (đặt mới hoặc hủy vé)
            if (diff != 0)
            {
                // Cập nhật lại chỉ số KPI tổng thể
                CalculateKpis();
                RecentBookingsCount += Math.Abs(diff);
                // Công thức tính toán tốc độ đặt vé (Velocity) làm mượt dữ liệu
                Velocity = Velocity * 0.5 + Math.Abs(diff) * 0.5 * 10; 

                // Truy vấn thông tin chi tiết của giao dịch đặt vé vừa thành công để làm tooltip cho điểm đồ thị mới
                string tooltip = "Không có hoạt động";
                if (diff > 0)
                {
                    try
                    {
                        var newBooking = await DbContext.Bookings
                            .Where(b => b.EventId == eventId && b.Status == "Confirmed")
                            .Include(b => b.Student)
                            .Include(b => b.Event)
                            .OrderByDescending(b => b.BookingTime)
                            .FirstOrDefaultAsync();

                        if (newBooking != null)
                        {
                            tooltip = $"Mới đặt - Học sinh: {newBooking.Student?.FullName ?? "N/A"} | Sự kiện: {newBooking.Event?.Title ?? "N/A"} ({newBooking.BookingTime.ToLocalTime().ToString("HH:mm:ss")})";
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine("Lỗi lấy thông tin booking mới: " + ex.Message);
                    }
                }
                else
                {
                    tooltip = $"Hủy đặt vé - Sự kiện: {ev.Title}";
                }

                // Thêm điểm dữ liệu mới vào đồ thị SVG
                ChartData.Add(new ChartPointDto
                {
                    Value = TotalRegisteredCount,
                    TooltipText = tooltip
                });
                // Chỉ giữ lại tối đa 10 điểm trên biểu đồ để tránh làm rối mắt
                if (ChartData.Count > 10) ChartData.RemoveAt(0);

                // Tạo dòng ghi nhận log sự kiện ở danh sách bên phải
                var logMessage = diff > 0 
                    ? $"Cập nhật thời gian thực: Đăng ký vé thành công (+{diff} vé)" 
                    : $"Cập nhật thời gian thực: Hủy đăng ký vé thành công ({diff} vé)";
                
                LiveLogs.Insert(0, new()
                {
                    Message = logMessage,
                    EventTitle = ev.Title,
                    Timestamp = DateTime.Now,
                    StatusClass = diff > 0 ? "badge-success" : "badge-warning",
                    StatusText = diff > 0 ? "ĐÃ ĐẶT" : "ĐÃ HỦY"
                });

                // Giới hạn nhật ký tối đa 25 dòng
                if (LiveLogs.Count > 25) LiveLogs.RemoveAt(25);

                // Yêu cầu UI render lại giao diện với số liệu mới
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    // --- CÁC HÀM PHỤ TRỢ VẼ ĐỒ THỊ SVG ---
    
    // Tạo đường bao viền (Line Path) kết nối các điểm dữ liệu lại với nhau trong SVG
    private string GetLinePath()
    {
        if (ChartData == null || ChartData.Count < 2) return "";
        var points = new List<string>();
        for (int i = 0; i < ChartData.Count; i++)
        {
            var (x, y) = GetPointCoords(i);
            points.Add($"{x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)},{y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}");
        }
        return "M " + string.Join(" L ", points);
    }

    // Tạo đa giác tô màu nền gradient bên dưới đường Line Path để tạo hiệu ứng Area Chart
    private string GetAreaPath()
    {
        var linePath = GetLinePath();
        if (string.IsNullOrEmpty(linePath)) return "";
        return $"{linePath} L 500.0,200.0 L 0.0,200.0 Z";
    }

    // Tính toán tọa độ (X, Y) thực tế của một điểm dữ liệu dựa trên tỉ lệ kích thước khung đồ thị (500x200)
    private (double x, double y) GetPointCoords(int index)
    {
        if (ChartData == null || ChartData.Count == 0) return (0, 0);

        // Chia đều trục X thành 10 phần từ 0 đến 500
        double x = index * (500.0 / (ChartData.Count - 1));

        int min = ChartData.Min(p => p.Value);
        int max = ChartData.Max(p => p.Value);
        int range = max - min;
        // Đặt khoảng chia tối thiểu là 10 để tránh đường vẽ nhảy vọt hết khung khi thay đổi nhỏ (ví dụ từ 150 lên 151)
        if (range < 10) range = 10;

        // Chuẩn hóa Y về tỉ lệ từ 0 đến 1. Tọa độ Y trong SVG bằng 0 nằm ở trên cùng nên ta làm đảo ngược
        double normalized = (double)(ChartData[index].Value - min) / range;
        double y = 175.0 - (normalized * 130.0); // Chừa 25px lề trên dưới

        return (x, y);
    }

    // Giải phóng kết nối SignalR khi rời khỏi trang Dashboard để tránh rò rỉ tài nguyên mạng
    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
