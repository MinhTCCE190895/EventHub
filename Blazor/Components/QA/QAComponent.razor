@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Authorization
@using BLL.Interfaces
@using BLL.DTOs
@inject ICommentService CommentService
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="card-glass qa-card-container mt-4 p-4">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-10">
        <h5 class="fw-bold mb-0 text-slate-800 d-flex align-items-center gap-2">
            <i class="bi bi-chat-left-text-fill text-primary"></i> Live Q&A Hub
        </h5>
        <span class="badge bg-primary bg-opacity-10 text-primary px-2.5 py-1 text-xs fw-semibold">
            @Comments.Count bình luận
        </span>
    </div>

    <!-- Danh sách bình luận -->
    <div class="comments-scroll-area mb-3" style="max-height: 400px; overflow-y: auto; padding-right: 5px;">
        @if (!Comments.Any())
        {
            <div class="text-center my-4 py-3 text-muted">
                <i class="bi bi-chat-quote display-6 d-block mb-2 text-slate-300"></i>
                <p class="small mb-0">Chưa có câu hỏi hay bình luận nào. Hãy là người đầu tiên đặt câu hỏi!</p>
            </div>
        }
        else
        {
            @foreach (var c in Comments)
            {
                <div class="comment-bubble-wrapper mb-3 p-3 rounded-3 bg-white border border-light shadow-3xs position-relative" id="comment-@c.Id">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <div class="d-flex align-items-center gap-2">
                            <div class="avatar-placeholder rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                @GetInitials(c.UserFullName)
                            </div>
                            <div>
                                <strong class="text-slate-800 text-sm">@c.UserFullName</strong>
                                <span class="badge ms-1" style="font-size: 0.65rem; @c.RoleBadgeStyle">@c.RoleBadgeText</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-1">
                            <small class="text-muted text-xs me-1">@c.CreatedAt.ToLocalTime().ToString("HH:mm:ss dd/MM")</small>

                            @if (CurrentUserRole == "Admin" || (CurrentUserId != null && c.UserId == CurrentUserId))
                            {
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-link text-slate-400 p-0 text-decoration-none" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3" style="font-size: 0.8rem;">
                                        @if (CurrentUserRole == "Admin" && !c.IsHidden)
                                        {
                                            <li>
                                                <button type="button" class="dropdown-item text-warning fw-semibold" @onclick="() => RequestHideComment(c.Id)">
                                                    <i class="bi bi-eye-slash me-1"></i> Ẩn bình luận
                                                </button>
                                            </li>
                                        }
                                        <li>
                                            <button type="button" class="dropdown-item text-danger fw-semibold" @onclick="() => RequestDeleteComment(c.Id)">
                                                <i class="bi bi-trash me-1"></i> Xóa bình luận
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="comment-content text-sm ps-4 ms-2 mb-2">
                        @if (c.IsHidden)
                        {
                            <span class="text-muted fst-italic">
                                <i class="bi bi-eye-slash me-1"></i> Bình luận đã bị admin ẩn
                            </span>
                        }
                        else
                        {
                            <span class="text-slate-700">@c.Content</span>
                        }
                    </div>

                    <div class="ps-4 ms-2">
                        @if (CurrentUserId != null)
                        {
                            <button type="button" class="btn btn-link text-xs text-decoration-none text-primary p-0 fw-semibold" @onclick="() => SetReplyTarget(c.Id, c.UserFullName)">
                                <i class="bi bi-reply-fill me-1"></i>Trả lời
                            </button>
                        }
                    </div>

                    <!-- Confirm Dialogs for Admin -->
                    @if (ConfirmingHideCommentId == c.Id)
                    {
                        <div class="mt-2 p-2 rounded-3 bg-warning bg-opacity-10 border border-warning border-opacity-25 d-flex align-items-center justify-content-between text-xs">
                            <span class="text-warning-emphasis fw-semibold"><i class="bi bi-exclamation-triangle-fill me-1"></i> Xóa hiển thị bình luận này?</span>
                            <div class="d-flex gap-1">
                                <button class="btn btn-xs btn-secondary py-0 px-2 fw-bold" @onclick="CancelHideComment">Hủy</button>
                                <button class="btn btn-xs btn-warning py-0 px-2 fw-bold" @onclick="() => ConfirmHideCommentAsync(c.Id)">Xác nhận ẩn</button>
                            </div>
                        </div>
                    }
                    @if (ConfirmingDeleteCommentId == c.Id)
                    {
                        <div class="mt-2 p-2 rounded-3 bg-danger bg-opacity-10 border border-danger border-opacity-25 d-flex align-items-center justify-content-between text-xs">
                            <span class="text-danger fw-semibold"><i class="bi bi-trash-fill me-1"></i> Xóa vĩnh viễn bình luận này?</span>
                            <div class="d-flex gap-1">
                                <button class="btn btn-xs btn-secondary py-0 px-2 fw-bold" @onclick="CancelDeleteComment">Hủy</button>
                                <button class="btn btn-xs btn-danger py-0 px-2 fw-bold" @onclick="() => ConfirmDeleteCommentAsync(c.Id)">Xóa vĩnh viễn</button>
                            </div>
                        </div>
                    }

                    <!-- Dropdown danh sách câu trả lời (FB / TikTok style) -->
                    @if (c.Replies != null && c.Replies.Any())
                    {
                        <div class="mt-2 ms-4">
                            <button type="button" class="btn btn-link p-0 text-decoration-none text-slate-600 text-xs fw-semibold d-inline-flex align-items-center gap-1" @onclick="() => ToggleReplies(c.Id)">
                                <i class="bi bi-arrow-return-right"></i>
                                <span>@(ExpandedReplyCommentIds.Contains(c.Id) ? "▲ Ẩn câu trả lời" : $"Xem {c.Replies.Count} câu trả lời")</span>
                            </button>

                            @if (ExpandedReplyCommentIds.Contains(c.Id))
                            {
                                <div class="replies-list ms-2 ps-3 border-start border-2 border-slate-200 mt-2">
                                    @foreach (var r in c.Replies)
                                    {
                                        <div class="comment-bubble-wrapper p-2.5 mb-2 bg-slate-50 rounded-3 border border-light position-relative" id="comment-@r.Id">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="avatar-placeholder rounded-circle bg-primary bg-opacity-75 text-white d-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.7rem;">
                                                        @GetInitials(r.UserFullName)
                                                    </div>
                                                    <div>
                                                        <strong class="text-slate-800 text-xs">@r.UserFullName</strong>
                                                        <span class="badge ms-1" style="font-size: 0.6rem; @r.RoleBadgeStyle">@r.RoleBadgeText</span>
                                                    </div>
                                                </div>

                                                <div class="d-flex align-items-center gap-1">
                                                    <small class="text-muted text-xs me-1">@r.CreatedAt.ToLocalTime().ToString("HH:mm:ss dd/MM")</small>

                                                    @if (CurrentUserRole == "Admin" || (CurrentUserId != null && r.UserId == CurrentUserId))
                                                    {
                                                        <div class="dropdown">
                                                            <button class="btn btn-sm btn-link text-slate-400 p-0 text-decoration-none" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                                <i class="bi bi-three-dots-vertical"></i>
                                                            </button>
                                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3" style="font-size: 0.8rem;">
                                                                @if (CurrentUserRole == "Admin" && !r.IsHidden)
                                                                {
                                                                    <li>
                                                                        <button type="button" class="dropdown-item text-warning fw-semibold" @onclick="() => RequestHideComment(r.Id)">
                                                                            <i class="bi bi-eye-slash me-1"></i> Ẩn bình luận
                                                                        </button>
                                                                    </li>
                                                                }
                                                                <li>
                                                                    <button type="button" class="dropdown-item text-danger fw-semibold" @onclick="() => RequestDeleteComment(r.Id)">
                                                                        <i class="bi bi-trash me-1"></i> Xóa bình luận
                                                                    </button>
                                                                </li>
                                                            </ul>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <div class="comment-content text-xs ps-4 ms-1">
                                                @if (r.IsHidden)
                                                {
                                                    <span class="text-muted fst-italic">
                                                        <i class="bi bi-eye-slash me-1"></i> Bình luận đã bị admin ẩn
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-700">@r.Content</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- Nhập bình luận mới -->
    @if (CurrentUserId == null)
    {
        <div class="alert alert-warning text-center small mb-0 rounded-3 border-0">
            Bạn cần <a href="@GetLoginUrl()" class="fw-bold text-decoration-none">đăng nhập</a> để tham gia hỏi đáp trực tiếp.
        </div>
    }
    else
    {
        @if (ReplyingToCommentId != null)
        {
            <div class="alert alert-info py-1 px-3 mb-2 text-xs fw-semibold d-flex justify-content-between align-items-center rounded-3">
                <span><i class="bi bi-reply-fill me-1"></i> Đang trả lời <strong>@ReplyingToUserName</strong></span>
                <button type="button" class="btn-close btn-sm" style="font-size: 0.65rem;" @onclick="CancelReply"></button>
            </div>
        }

        <div class="input-group">
            <textarea class="form-control form-control-minimal" 
                      rows="2" 
                      placeholder="@(ReplyingToCommentId != null ? $"Trả lời {ReplyingToUserName}..." : "Nhập câu hỏi hoặc ý kiến của bạn...")" 
                      @bind="NewCommentText" 
                      disabled="@IsSending"
                      @onkeydown="HandleKeyDown">
            </textarea>
            <button class="btn btn-primary px-4 fw-bold text-white d-flex align-items-center justify-content-center" 
                    type="button" 
                    @onclick="SendCommentAsync" 
                    disabled="@(IsSending || string.IsNullOrWhiteSpace(NewCommentText))">
                @if (IsSending)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <i class="bi bi-send-fill"></i>
                }
            </button>
        </div>
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger py-1.5 px-3 mt-2 text-xs fw-semibold mb-0 rounded-3 border-0">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @ErrorMessage
            </div>
        }
    }
</div>

<style>
    .qa-card-container {
        border-radius: var(--radius-lg);
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(226, 232, 240, 0.7);
    }
    .text-sm {
        font-size: 0.88rem !important;
    }
    .text-xs {
        font-size: 0.78rem !important;
    }
    .text-3xs {
        font-size: 0.65rem !important;
    }
    .shadow-3xs {
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
    }
    .avatar-placeholder {
        user-select: none;
    }
    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 0.75rem;
    }
</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter]
    public Guid EventId { get; set; }

    private List<CommentDTO> Comments = new();
    private string NewCommentText = "";
    private bool IsSending = false;
    private string ErrorMessage = "";

    private HubConnection? hubConnection;
    private Guid? CurrentUserId;
    private string? CurrentUserFullName;
    private string? CurrentUserRole;
    private Guid? ConfirmingHideCommentId;
    private Guid? ConfirmingDeleteCommentId;

    private HashSet<Guid> ExpandedReplyCommentIds = new();
    private Guid? ReplyingToCommentId;
    private string? ReplyingToUserName;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var authState = await AuthState;
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var nameIdentifier = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                if (Guid.TryParse(nameIdentifier, out var userId))
                {
                    CurrentUserId = userId;
                    CurrentUserFullName = user.Identity.Name;
                    CurrentUserRole = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                }
            }
        }

        try
        {
            var list = await CommentService.GetCommentsForEventAsync(EventId);
            Comments = list.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi tải lịch sử bình luận Q&A: " + ex.Message);
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = Task.Run(async () =>
            {
                try
                {
                    hubConnection = new HubConnectionBuilder()
                        .WithUrl(Navigation.ToAbsoluteUri("/eventhub"), options =>
                        {
                            options.HttpMessageHandlerFactory = (message) =>
                            {
                                if (message is HttpClientHandler clientHandler)
                                    clientHandler.ServerCertificateCustomValidationCallback += (sender, cert, chain, sslErrors) => true;
                                return message;
                            };
                        })
                        .WithAutomaticReconnect()
                        .Build();

                    hubConnection.On<Guid, Guid, string, string, string, string, Guid?, Guid>("ReceiveComment", (id, commentId, author, content, time, role, parentCommentId, commentUserId) =>
                    {
                        if (id == EventId)
                        {
                            var newDto = new CommentDTO
                            {
                                Id = commentId,
                                EventId = id,
                                UserId = commentUserId,
                                UserFullName = author,
                                UserRole = role,
                                Content = content,
                                CreatedAt = DateTime.UtcNow,
                                ParentCommentId = parentCommentId
                            };

                            if (parentCommentId.HasValue)
                            {
                                var parent = Comments.FirstOrDefault(c => c.Id == parentCommentId.Value);
                                if (parent != null)
                                {
                                    parent.Replies.Add(newDto);
                                    ExpandedReplyCommentIds.Add(parentCommentId.Value);
                                }
                            }
                            else
                            {
                                Comments.Add(newDto);
                            }
                            InvokeAsync(StateHasChanged);
                        }
                    });

                    hubConnection.On<Guid>("ReceiveCommentHidden", (commentId) =>
                    {
                        foreach (var c in Comments)
                        {
                            if (c.Id == commentId) c.IsHidden = true;
                            foreach (var r in c.Replies)
                            {
                                if (r.Id == commentId) r.IsHidden = true;
                            }
                        }
                        InvokeAsync(StateHasChanged);
                    });

                    hubConnection.On<Guid>("ReceiveCommentDeleted", (commentId) =>
                    {
                        RemoveCommentFromList(commentId);
                        InvokeAsync(StateHasChanged);
                    });

                    await hubConnection.StartAsync();
                }
                catch (Exception ex)
                {
                    Console.WriteLine("Lỗi kết nối SignalR (Comments): " + ex.Message);
                }
            });
        }
        return Task.CompletedTask;
    }

    private void ToggleReplies(Guid commentId)
    {
        if (!ExpandedReplyCommentIds.Remove(commentId))
        {
            ExpandedReplyCommentIds.Add(commentId);
        }
    }

    private void SetReplyTarget(Guid commentId, string authorName)
    {
        ReplyingToCommentId = commentId;
        ReplyingToUserName = authorName;
    }

    private void CancelReply()
    {
        ReplyingToCommentId = null;
        ReplyingToUserName = null;
    }

    private async Task SendCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(NewCommentText) || CurrentUserId == null || IsSending) return;

        IsSending = true;
        ErrorMessage = "";
        StateHasChanged();

        try
        {
            if (hubConnection != null && hubConnection.State == HubConnectionState.Connected)
            {
                await hubConnection.SendAsync("SendComment", EventId, CurrentUserId.Value, NewCommentText.Trim(), ReplyingToCommentId);
                NewCommentText = "";
                CancelReply();
            }
            else
            {
                ErrorMessage = "Mất kết nối với máy chủ thời gian thực. Đang thử gửi trực tiếp...";
                var saved = await CommentService.AddCommentAsync(EventId, CurrentUserId.Value, NewCommentText.Trim(), ReplyingToCommentId);
                if (ReplyingToCommentId.HasValue)
                {
                    var parent = Comments.FirstOrDefault(c => c.Id == ReplyingToCommentId.Value);
                    if (parent != null) parent.Replies.Add(saved);
                }
                else
                {
                    Comments.Add(saved);
                }
                NewCommentText = "";
                CancelReply();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSending = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendCommentAsync();
        }
    }

    private void RequestHideComment(Guid commentId)
    {
        ConfirmingHideCommentId = commentId;
    }

    private void CancelHideComment()
    {
        ConfirmingHideCommentId = null;
    }

    private async Task ConfirmHideCommentAsync(Guid commentId)
    {
        if (CurrentUserId == null || CurrentUserRole != "Admin") return;
        ConfirmingHideCommentId = null;
        try
        {
            if (hubConnection != null && hubConnection.State == HubConnectionState.Connected)
            {
                await hubConnection.SendAsync("HideComment", commentId, CurrentUserId.Value);
            }
            else
            {
                await CommentService.HideCommentAsync(commentId, CurrentUserId.Value);
                foreach (var c in Comments)
                {
                    if (c.Id == commentId) c.IsHidden = true;
                    foreach (var r in c.Replies)
                    {
                        if (r.Id == commentId) r.IsHidden = true;
                    }
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private void RequestDeleteComment(Guid commentId)
    {
        ConfirmingDeleteCommentId = commentId;
    }

    private void CancelDeleteComment()
    {
        ConfirmingDeleteCommentId = null;
    }

    private async Task ConfirmDeleteCommentAsync(Guid commentId)
    {
        if (CurrentUserId == null) return;
        ConfirmingDeleteCommentId = null;
        try
        {
            if (hubConnection != null && hubConnection.State == HubConnectionState.Connected)
            {
                await hubConnection.SendAsync("DeleteComment", commentId, CurrentUserId.Value);
            }
            else
            {
                await CommentService.DeleteCommentAsync(commentId, CurrentUserId.Value);
                RemoveCommentFromList(commentId);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private void RemoveCommentFromList(Guid commentId)
    {
        Comments.RemoveAll(c => c.Id == commentId);
        foreach (var parent in Comments)
        {
            parent.Replies.RemoveAll(r => r.Id == commentId);
        }
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "U";
        var parts = fullName.Trim().Split(' ');
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[parts.Length - 1][0].ToString()).ToUpper();
    }

    private string GetLoginUrl()
    {
        var isHttps = Navigation.Uri.StartsWith("https");
        var baseLoginUrl = isHttps ? "https://localhost:7298/Account/Login" : "http://localhost:5259/Account/Login";
        return $"{baseLoginUrl}?returnUrl={Uri.EscapeDataString(Navigation.Uri)}";
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
