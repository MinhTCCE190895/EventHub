@page "/events/{EventId:guid}/book"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Authorization
@using DAL.Data
@using DAL.Entities
@using Microsoft.EntityFrameworkCore
@using BLL.Services
@attribute [Authorize(Roles = "Student")]
@inject AppDbContext DbContext
@inject NavigationManager Navigation
@inject IBookingService BookingService
@implements IAsyncDisposable

<div class="page-header-minimal text-center mb-4">
    <span class="page-badge-minimal">Đặt vé trực tiếp</span>
    <h1 class="display-6 fw-bold mt-1">Đặt Vé Sự Kiện</h1>
    <p class="text-muted">Cập nhật chỗ trống theo thời gian thực (SignalR)</p>
</div>

<div class="d-flex justify-content-center">
    @if (EventItem == null)
    {
        <div class="alert alert-info">Đang tải thông tin sự kiện...</div>
    }
    else
    {
        var remaining = EventItem.MaxCapacity - EventItem.RegisteredCount;
        var progressPercentage = EventItem.MaxCapacity > 0 ? (EventItem.RegisteredCount * 100 / EventItem.MaxCapacity) : 0;
        var isSoldOut = remaining <= 0;
        var hasEnded = EventItem.EndTime < DateTime.UtcNow;

        <div class="card-minimal" style="max-width: 500px; width: 100%;">
            @if (isSoldOut)
            {
                <span class="card-badge-overlay bg-danger text-white">Hết Vé</span>
            }
            else if (hasEnded)
            {
                <span class="card-badge-overlay bg-secondary text-white">Đã Kết Thúc</span>
            }

            <div class="card-minimal-body">
                @if (!string.IsNullOrEmpty(ConnectionStatus) && ConnectionStatus != "Đã kết nối")
                {
                    <div class="alert alert-warning text-center py-2 mb-3 small fw-bold">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        Trạng thái kết nối: @ConnectionStatus
                    </div>
                }

                <h3 class="fw-bold text-center mb-3">@EventItem.Title</h3>
                
                <div class="d-flex justify-content-between text-muted small mt-2 mb-1">
                    <span>Địa điểm: @EventItem.VenueName</span>
                    <span>Giới hạn: @EventItem.MaxCapacity người</span>
                </div>
                
                <div class="d-flex justify-content-between mt-3 mb-1">
                    <strong>Trạng thái vé:</strong>
                    <span class="@(hasEnded ? "text-secondary" : (isSoldOut ? "text-danger" : "text-success")) fw-bold">
                        @(hasEnded ? "Đã kết thúc" : (isSoldOut ? "Đã Hết Vé" : $"Còn {remaining} chỗ"))
                    </span>
                </div>

                <div class="progress-bar-container mb-4">
                    <div class="progress-bar-fill @(hasEnded ? "bg-secondary" : (isSoldOut ? "bg-danger" : "bg-success"))" 
                         style="width: @progressPercentage%">
                    </div>
                </div>

                <button class="btn @(hasEnded ? "btn-secondary" : (isSoldOut ? "btn-secondary" : "btn-primary")) w-100 py-3 fw-bold shadow-sm text-white" 
                        disabled="@(hasEnded || isSoldOut || IsProcessing || CurrentUserId == null || CurrentUserRole != "Student" || ConnectionStatus == "Mất kết nối")"
                        @onclick="BookTicketAsync">
                    @if (IsProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Đang xử lý...</span>
                    }
                    else if (hasEnded)
                    {
                        <i class="bi bi-calendar-x-fill me-2"></i>
                        <span>Sự Kiện Đã Kết Thúc</span>
                    }
                    else if (isSoldOut)
                    {
                        <i class="bi bi-x-circle-fill me-2"></i>
                        <span>Sự Kiện Hết Vé</span>
                    }
                    else
                    {
                        <i class="bi bi-ticket-perforated-fill me-2"></i>
                        <span>Xác Nhận Đặt Vé</span>
                    }
                </button>

                @if (ConnectionStatus == "Mất kết nối")
                {
                    <div class="alert alert-danger mt-3 text-center py-2">
                        <i class="bi bi-wifi-off me-2"></i> Kết nối thời gian thực bị gián đoạn (Timeout).
                        <div class="d-flex justify-content-center gap-2 mt-2">
                            <button class="btn btn-sm btn-danger px-3 py-1 text-white fw-bold" @onclick="ReloadPage">
                                <i class="bi bi-arrow-clockwise me-1"></i> Tải lại trang
                            </button>
                            <a href="http://localhost:5129/Index" class="btn btn-sm btn-outline-secondary px-3 py-1 fw-bold text-decoration-none">
                                <i class="bi bi-compass me-1"></i> Khám phá
                            </a>
                        </div>
                    </div>
                }

                @if (hasEnded)
                {
                    <div class="alert alert-danger mt-3 text-center small fw-bold">
                        Sự kiện này đã kết thúc vào lúc @EventItem.EndTime.ToString("dd/MM/yyyy HH:mm"). Bạn không thể đặt vé.
                    </div>
                }
                else if (CurrentUserId == null)
                {
                    <div class="alert alert-warning mt-3 text-center small">
                        Bạn cần <a href="@GetLoginUrl()" class="fw-bold text-decoration-none">đăng nhập</a> làm sinh viên để đặt vé.
                    </div>
                }
                else if (CurrentUserRole != "Student")
                {
                    <div class="alert alert-danger mt-3 text-center small">
                        Chỉ tài khoản sinh viên mới được đặt vé.
                    </div>
                }

                @if (!string.IsNullOrEmpty(Message))
                {
                    <div class="alert @(IsSuccess ? "alert-success" : "alert-danger") mt-3 text-center fw-bold">
                        @Message
                    </div>
                }

                <a href="http://localhost:5129/Events/Detail/@EventId" class="btn btn-outline-secondary w-100 py-2 fw-semibold mt-3 d-flex align-items-center justify-content-center text-decoration-none">
                    <i class="bi bi-arrow-left me-2"></i> Quay lại chi tiết sự kiện
                </a>
            </div>
        </div>
    }
</div>

@code {
    // Nhận thông tin đăng nhập của user từ Cookie SSO qua Cascading Parameter
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    // Nhận EventId truyền vào từ URL Route của trang đặt vé
    [Parameter]
    public Guid EventId { get; set; }

    // DTO chứa thông tin chi tiết sự kiện hiển thị trên UI
    private EventDto? EventItem;

    // Đối tượng kết nối SignalR Client đến Hub của Server
    private HubConnection? hubConnection;

    // Biến cờ đánh dấu trạng thái đang gọi API đặt vé lên Server
    private bool IsProcessing = false;

    // Thông báo phản hồi sau khi đặt vé (Thành công hoặc Lỗi chi tiết)
    private string Message = "";

    // Cờ báo kết quả đặt vé thành công hay thất bại để đổi class alert CSS tương ứng
    private bool IsSuccess = false;

    // Id của sinh viên hiện tại đã đăng nhập hệ thống
    private Guid? CurrentUserId;

    // Vai trò của người dùng hiện tại (bắt buộc phải là "Student" mới được book)
    private string? CurrentUserRole;

    // Trạng thái kết nối SignalR (Đang kết nối, Đang kết nối lại, Đã kết nối, Mất kết nối)
    private string ConnectionStatus = "Đang kết nối...";

    // Class đại diện cho thông tin sự kiện được lấy từ database
    public class EventDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string VenueName { get; set; } = string.Empty;
        public int MaxCapacity { get; set; }
        public int RegisteredCount { get; set; }
        public DateTime EndTime { get; set; }
    }

    // Vòng đời khởi tạo component: Load thông tin sự kiện ban đầu và thông tin phân quyền user
    protected override async Task OnInitializedAsync()
    {
        // 1. Phân tích Claims trong AuthenticationState để lấy UserId và UserRole
        if (AuthState != null)
        {
            var authState = await AuthState;
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var nameIdentifier = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                if (Guid.TryParse(nameIdentifier, out var userId))
                {
                    CurrentUserId = userId;
                    CurrentUserRole = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                }
            }
        }

        // 2. Tải thông tin chi tiết sự kiện (bao gồm sức chứa địa điểm và số người đã đăng ký)
        try
        {
            var ev = await DbContext.Events
                .Include(e => e.Venue)
                .AsNoTracking()
                .FirstOrDefaultAsync(e => e.Id == EventId);

            if (ev != null)
            {
                EventItem = new EventDto
                {
                    Id = ev.Id,
                    Title = ev.Title,
                    VenueName = ev.Venue.Name,
                    MaxCapacity = ev.Venue.MaxCapacity,
                    RegisteredCount = ev.RegisteredCount,
                    EndTime = ev.EndTime
                };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi load chi tiết sự kiện: " + ex.Message);
        }
    }

    // Vòng đời chạy sau khi component đã render giao diện: Thiết lập kết nối SignalR thời gian thực
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && EventItem != null)
        {
            // Khởi chạy ngầm tiến trình kết nối SignalR để tránh chặn luồng render giao diện chính
            _ = Task.Run(async () =>
            {
                try
                {
                    // Cấu hình SignalR Hub Connection với cơ chế Tự động kết nối lại (Automatic Reconnect)
                    hubConnection = new HubConnectionBuilder()
                        .WithUrl(Navigation.ToAbsoluteUri("/eventhub"), options =>
                        {
                            // Bỏ qua xác thực SSL ở môi trường localhost phát triển nếu có
                            options.HttpMessageHandlerFactory = (message) =>
                            {
                                if (message is HttpClientHandler clientHandler)
                                    clientHandler.ServerCertificateCustomValidationCallback += (sender, cert, chain, sslErrors) => true;
                                else if (message is SocketsHttpHandler socketsHandler)
                                    socketsHandler.SslOptions.RemoteCertificateValidationCallback += (sender, cert, chain, sslErrors) => true;
                                return message;
                            };
                        })
                        .WithAutomaticReconnect(new[] { TimeSpan.Zero, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(10) })
                        .Build();

                    // Cấu hình Timeout tối đa là 10 giây. Nếu sau 10s không có phản hồi từ Server thì sẽ kích hoạt gián đoạn
                    hubConnection.ServerTimeout = TimeSpan.FromSeconds(10);

                    // Đăng ký sự kiện lắng nghe broadcast từ Server gửi về khi có cập nhật chỗ trống
                    hubConnection.On<Guid, int>("ReceiveTicketUpdate", (id, remainingSeats) =>
                    {
                        if (EventItem != null && EventItem.Id == id)
                        {
                            // Tính toán lại số lượng vé đã đăng ký dựa trên số ghế trống nhận được
                            EventItem.RegisteredCount = EventItem.MaxCapacity - remainingSeats;
                            // Gọi InvokeAsync để bắt buộc giao diện cập nhật trạng thái trên luồng UI
                            InvokeAsync(StateHasChanged);
                        }
                    });

                    // Đăng ký các sự kiện quản lý vòng đời kết nối để hiển thị lên thanh thông báo trạng thái
                    hubConnection.Reconnecting += (error) =>
                    {
                        ConnectionStatus = "Đang kết nối lại...";
                        InvokeAsync(StateHasChanged);
                        return Task.CompletedTask;
                    };

                    hubConnection.Reconnected += (connectionId) =>
                    {
                        ConnectionStatus = "Đã kết nối";
                        InvokeAsync(StateHasChanged);
                        return Task.CompletedTask;
                    };

                    hubConnection.Closed += (error) =>
                    {
                        ConnectionStatus = "Mất kết nối";
                        InvokeAsync(StateHasChanged);
                        return Task.CompletedTask;
                    };

                    // Bắt đầu kết nối lên Hub
                    await hubConnection.StartAsync();
                    ConnectionStatus = "Đã kết nối";
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    ConnectionStatus = "Mất kết nối";
                    await InvokeAsync(StateHasChanged);
                    Console.WriteLine("Lỗi khởi tạo SignalR Client (Booking): " + ex.Message);
                }
            });
        }
    }

    // Nghiệp vụ Đặt Vé: Gọi Service ở tầng BLL thực thi logic nghiệp vụ (với transaction Serializable chống race condition)
    private async Task BookTicketAsync()
    {
        if (EventItem == null || IsProcessing) return;

        // Xác thực người dùng
        if (CurrentUserId == null)
        {
            Message = "Bạn cần đăng nhập trước khi thực hiện đặt vé.";
            IsSuccess = false;
            return;
        }

        // Xác thực phân quyền
        if (CurrentUserRole != "Student")
        {
            Message = "Chỉ tài khoản sinh viên mới được phép đặt vé.";
            IsSuccess = false;
            return;
        }

        IsProcessing = true;
        Message = "";
        StateHasChanged();

        try
        {
            // Thực hiện gọi service xử lý đặt vé
            var ticketCode = await BookingService.BookTicketAsync(EventItem.Id, CurrentUserId.Value);
            
            IsSuccess = true;
            Message = $"Đặt vé thành công! Mã vé của bạn: {ticketCode}";
        }
        catch (Exception ex)
        {
            IsSuccess = false;
            // Hiển thị trực tiếp thông báo lỗi nghiệp vụ trả về từ DB/Service (ví dụ: hết vé, trùng vé, trùng tab)
            Message = ex.Message;
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    // Hàm phụ trợ tạo đường dẫn đến trang Login của phân hệ Identity (MVC)
    private string GetLoginUrl()
    {
        var isHttps = Navigation.Uri.StartsWith("https");
        var baseLoginUrl = isHttps ? "https://localhost:7298/Account/Login" : "http://localhost:5259/Account/Login";
        return $"{baseLoginUrl}?returnUrl={Uri.EscapeDataString(Navigation.Uri)}";
    }

    // Nút điều hướng khẩn cấp khi mất kết nối (Dead-end bypass) - Tải lại trang hiện tại
    private void ReloadPage()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    // Giải phóng kết nối SignalR khi rời khỏi component nhằm giải phóng tài nguyên
    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
