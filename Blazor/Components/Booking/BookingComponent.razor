@page "/events/{EventId:guid}/book"
@using Microsoft.AspNetCore.SignalR.Client
@using BLL.Services
@using DAL.Entities
@using Microsoft.EntityFrameworkCore
@inject IBookingService BookingService
@inject DAL.Data.AppDbContext DbContext
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="app-container">
    <main class="app-content w-100 p-4">
        <div class="content-body">
            @if (EventItem == null)
            {
                <div class="skeleton-card">
                    <div class="skeleton-image"></div>
                    <div class="skeleton-body">
                        <div class="skeleton-line title"></div>
                        <div class="skeleton-line text"></div>
                    </div>
                </div>
            }
            else
            {
                <div class="card-minimal">
                    <div class="card-minimal-body">
                        <h3 class="card-minimal-title">@EventItem.Title</h3>
                        <p class="text-muted">@EventItem.Description</p>
                        
                        <div class="mt-4 p-3 rounded" style="background-color: var(--border-color);">
                            <h4>Tình trạng vé</h4>
                            <p class="fs-4 fw-bold @(RemainingSeats <= 0 ? "text-danger" : "text-success")">
                                Còn lại: @RemainingSeats / @EventItem.Venue.MaxCapacity chỗ
                            </p>
                        </div>

                        <!-- Dropdown để test chọn User thật -->
                        <div class="mt-4">
                            <label class="form-label fw-bold">Tài khoản sinh viên (Mô phỏng Đăng nhập)</label>
                            @if (Students == null || !Students.Any())
                            {
                                <p class="text-danger small">Không tìm thấy sinh viên nào trong CSDL.</p>
                            }
                            else
                            {
                                <select class="form-select" @bind="currentStudentId">
                                    <option value="@Guid.Empty">-- Vui lòng chọn 1 Sinh viên --</option>
                                    @foreach (var s in Students)
                                    {
                                        <option value="@s.Id">@s.FullName (@s.Email)</option>
                                    }
                                </select>
                            }
                            <p class="small text-muted mt-1">
                                <em>Ghi chú (FE-04): Vì tính năng Authentication (FE-01) chưa hoàn thiện, anh Khôi hãy chọn một sinh viên có thật trong DB từ danh sách này để lấy User ID.</em>
                            </p>
                        </div>

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger mt-3">@ErrorMessage</div>
                        }

                        @if (!string.IsNullOrEmpty(SuccessMessage))
                        {
                            <div class="alert alert-success mt-3">
                                <strong>Thành công!</strong> Mã vé của bạn là: @SuccessMessage
                            </div>
                        }

                        <button class="btn btn-primary w-100 mt-4" 
                                style="border-radius: var(--radius-md);"
                                disabled="@(RemainingSeats <= 0 || IsProcessing || currentStudentId == Guid.Empty)"
                                @onclick="BookTicket">
                            @if (IsProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Đang xử lý...</span>
                            }
                            else
                            {
                                <i class="bi bi-ticket-perforated fw-bold me-2"></i>
                                <span>Booking</span>
                            }
                        </button>
                    </div>
                </div>
            }
        </div>
    </main>
</div>

@code {
    [Parameter]
    public Guid EventId { get; set; }

    private Event? EventItem;
    private int RemainingSeats;
    private HubConnection? hubConnection;
    private bool IsProcessing = false;
    private string? ErrorMessage;
    private string? SuccessMessage;

    // Lấy StudentId thật từ Database thay vì hardcode
    private Guid currentStudentId;
    private List<User> Students = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Tải Event hiện tại
            EventItem = await DbContext.Events
                .Include(e => e.Venue)
                .FirstOrDefaultAsync(e => e.Id == EventId);

            // Lấy danh sách tất cả Sinh viên có sẵn trong DB (Dữ liệu thật)
            Students = await DbContext.Users.Where(u => u.Role == "Student").ToListAsync();
            
            if (Students.Any())
            {
                currentStudentId = Students.First().Id;
            }

            if (EventItem != null)
            {
                RemainingSeats = EventItem.Venue.MaxCapacity - EventItem.RegisteredCount;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Lỗi khởi tạo trang: " + ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && EventItem != null)
        {
            try
            {
                // Thiết lập SignalR Client (chỉ khởi tạo sau khi component đã render xong)
                hubConnection = new HubConnectionBuilder()
                    .WithUrl(Navigation.ToAbsoluteUri("/eventhub"), options =>
                    {
                        options.HttpMessageHandlerFactory = (message) =>
                        {
                            if (message is HttpClientHandler clientHandler)
                            {
                                clientHandler.ServerCertificateCustomValidationCallback +=
                                    (sender, certificate, chain, sslPolicyErrors) => { return true; };
                            }
                            else if (message is SocketsHttpHandler socketsHandler)
                            {
                                socketsHandler.SslOptions.RemoteCertificateValidationCallback += 
                                    (sender, certificate, chain, sslPolicyErrors) => { return true; };
                            }
                            return message;
                        };
                    })
                    .Build();

                hubConnection.On<Guid, int>("ReceiveTicketUpdate", (eventId, remaining) =>
                {
                    if (eventId == EventId)
                    {
                        RemainingSeats = remaining;
                        InvokeAsync(StateHasChanged);
                    }
                });

                await hubConnection.StartAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine("Lỗi khởi tạo SignalR Client: " + ex.Message);
            }
        }
    }

    private async Task BookTicket()
    {
        Console.WriteLine(">>> Bắt đầu hàm BookTicket!");
        Console.WriteLine($">>> EventId: {EventId}, currentStudentId: {currentStudentId}");

        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;
        StateHasChanged();

        try
        {
            if (currentStudentId == Guid.Empty)
            {
                Console.WriteLine(">>> currentStudentId đang trống!");
                ErrorMessage = "Không tìm thấy User Sinh viên trong hệ thống để đặt vé.";
                return;
            }

            // Call service
            Console.WriteLine(">>> Đang gọi BookingService.BookTicketAsync...");
            var ticketCode = await BookingService.BookTicketAsync(EventId, currentStudentId);
            Console.WriteLine(">>> Đặt vé thành công, ticketCode: " + ticketCode);
            SuccessMessage = ticketCode;
            
            // Note: RemainingSeats sẽ được update tự động qua SignalR, 
            // tuy nhiên ta cũng có thể trừ local trước nếu muốn.
        }
        catch (DbUpdateConcurrencyException ex)
        {
            ErrorMessage = ex.Message; // "Có người khác đã đặt vé cùng lúc, vui lòng thử lại."
            
            // Refresh data từ DB để lấy count mới nhất
            var latestEvent = await DbContext.Events
                .AsNoTracking()
                .Include(e => e.Venue)
                .FirstOrDefaultAsync(e => e.Id == EventId);
                
            if (latestEvent != null)
            {
                EventItem = latestEvent;
                RemainingSeats = latestEvent.Venue.MaxCapacity - latestEvent.RegisteredCount;
            }
        }
        catch (Exception ex)
        {
            // Bắt các lỗi khác (ví dụ Khóa ngoại do thiếu StudentId, v.v)
            ErrorMessage = "Đã xảy ra lỗi khi đặt vé: " + ex.Message;
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged(); // Ép UI cập nhật lại trạng thái
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
