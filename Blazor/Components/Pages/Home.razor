@page "/events"

<HeadContent>
    <meta http-equiv="refresh" content="0;url=http://localhost:5129/" />
</HeadContent>

<div class="text-center mt-5">
    <div class="spinner-border text-primary" role="status"></div>
    <div class="mt-2">Đang chuyển hướng về trang khám phá sự kiện chính...</div>
</div>

@code {
    // Không dùng NavigationManager.NavigateTo trong OnInitialized vì nó sẽ throw NavigationException trong Blazor SSR (khiến Visual Studio ngắt debug).
    // Cũng không dùng OnAfterRenderAsync vì ở chế độ SSR tĩnh (không có @rendermode), hàm đó không bao giờ chạy.
    // Sử dụng thẻ <meta refresh> là cách tối ưu và an toàn nhất cho UX.
}
