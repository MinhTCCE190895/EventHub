@page "/events"
@inject NavigationManager Navigation

<div class="text-center mt-5">
    <div class="spinner-border text-primary" role="status"></div>
    <div class="mt-2">Đang chuyển hướng về trang khám phá sự kiện chính...</div>
</div>

@code {
    protected override void OnInitialized()
    {
        // Chuyển hướng người dùng về trang khám phá Razor Pages chính để thống nhất luồng
        Navigation.NavigateTo("http://localhost:5129/", forceLoad: true);
    }
}
