@using Microsoft.AspNetCore.Components.Authorization

<aside class="app-sidebar">
    <a href="" class="sidebar-brand">
        <i class="bi bi-calendar-event"></i>
        <span>EventHub</span>
    </a>
    <nav class="sidebar-nav">
        @* Live Dashboard — tất cả role đều thấy sau khi đăng nhập *@
        <AuthorizeView>
            <Authorized>
                <NavLink class="sidebar-link" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-activity"></i>
                    <span>Live Dashboard</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>

        @* Đặt vé — chỉ Student *@
        <AuthorizeView Roles="Student">
            <NavLink class="sidebar-link" href="events">
                <i class="bi bi-ticket-perforated"></i>
                <span>Đặt vé sự kiện</span>
            </NavLink>
        </AuthorizeView>

        @* Phân tích đánh giá — Admin và Organizer *@
        <AuthorizeView Roles="Admin,Organizer">
            <NavLink class="sidebar-link" href="feedback-analytics">
                <i class="bi bi-bar-chart-line-fill"></i>
                <span>Phân tích đánh giá</span>
            </NavLink>
        </AuthorizeView>
    </nav>
    <AuthorizeView>
        <Authorized>
            <div class="mt-auto p-3 border-top border-light">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px;">
                        @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div class="text-truncate fw-bold" style="font-size: 0.85rem;" title="@context.User.Identity?.Name">
                        @context.User.Identity?.Name
                    </div>
                </div>
                <a href="http://localhost:5259/Account/Logout" class="btn btn-outline-danger w-100 btn-sm rounded-3 py-1 fw-semibold">
                    <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                </a>
            </div>
        </Authorized>
    </AuthorizeView>
    <div class="sidebar-footer">
        &copy; 2026 EventHub.
    </div>
</aside>
