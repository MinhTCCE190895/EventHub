@using Microsoft.AspNetCore.Components.Authorization

<aside class="app-sidebar">
    <a href="" class="sidebar-brand">
        <i class="bi bi-shield-check text-primary"></i>
        <span>UniEventHub</span>
    </a>
    <nav class="sidebar-nav">
        <!-- Links visible to everyone -->
        <a class="sidebar-link" href="http://localhost:5129/Index">
            <i class="bi bi-compass-fill"></i> Khám phá sự kiện
        </a>

        <AuthorizeView Roles="Admin,Organizer">
            <Authorized>
                <NavLink class="sidebar-link" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-activity"></i> Live Dashboard
                </NavLink>

                <!-- Admin & Organizer only links -->
                <a class="sidebar-link" href="http://localhost:5129/Events">
                    <i class="bi bi-calendar-event-fill"></i> Quản lý sự kiện
                </a>
                <a class="sidebar-link" href="http://localhost:5129/Categories">
                    <i class="bi bi-tags-fill"></i> Quản lý danh mục
                </a>
                <a class="sidebar-link" href="http://localhost:5129/Tags">
                    <i class="bi bi-hash"></i> Quản lý Thẻ
                </a>
                <a class="sidebar-link" href="http://localhost:5129/Venues">
                    <i class="bi bi-building"></i> Quản lý địa điểm
                </a>
                <NavLink class="sidebar-link" href="feedback-analytics">
                    <i class="bi bi-bar-chart-line-fill"></i> Phân tích đánh giá
                </NavLink>
            </Authorized>
        </AuthorizeView>

        <!-- Student only links -->
        <AuthorizeView Roles="Student">
            <Authorized>
                <a class="sidebar-link" href="http://localhost:5129/">
                    <i class="bi bi-ticket-perforated-fill"></i> Đặt vé sự kiện (Live)
                </a>
                <a class="sidebar-link" href="http://localhost:5129/Events/MyFeedbacks">
                    <i class="bi bi-chat-left-heart-fill"></i> Đánh giá của tôi
                </a>
            </Authorized>
        </AuthorizeView>

        <a class="sidebar-link" href="http://localhost:5129/Privacy">
            <i class="bi bi-shield-lock-fill"></i> Riêng tư
        </a>
    </nav>
    <AuthorizeView>
        <Authorized>
            <div class="mt-auto p-3 border-top border-light">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px;">
                        @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div class="text-truncate fw-bold" style="font-size: 0.85rem;" title="@context.User.Identity?.Name">
                        @context.User.Identity?.Name
                    </div>
                </div>
                <a href="http://localhost:5259/Account/Logout" class="btn btn-outline-danger w-100 btn-sm rounded-3 py-1 fw-semibold">
                    <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                </a>
            </div>
        </Authorized>
    </AuthorizeView>
    <div class="sidebar-footer">
        &copy; 2026 UniEvent Hub
    </div>
</aside>
